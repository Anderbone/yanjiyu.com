---
import { translator, localeFrom, localePath } from "@/lib/i18n";

const locale = localeFrom(Astro.url);
const t = translator(Astro.url);

import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
const { data, collection = "dev" } = Astro.props;
const { title, description, date, categories = [] } = data.data;
---

<article class="post-card">
  <div class="post-meta">
    {
      date && (
        <time datetime={date.toISOString()}>
          {dateFormat(date, locale === "zh" ? "yyyy年M月d日" : undefined)}
        </time>
      )
    }{
      categories
        .slice(0, 2)
        .map((category: string) => (
          <a
            href={localePath(
              `/${collection}/categories/${slugify(category)}`,
              locale,
            )}
          >
            {t(humanize(category))}
          </a>
        ))
    }
  </div>
  <h3><a href={localePath(`/${collection}/${data.id}`, locale)}>{title}</a></h3>
  <p>{description || plainify(data.body?.slice(0, 200))}</p>
  <a
    class="post-read"
    href={localePath(`/${collection}/${data.id}`, locale)}
    aria-label={`${t("Read")} ${title}`}
    >{t("Read story")} <span aria-hidden="true">↗</span></a
  >
</article>
