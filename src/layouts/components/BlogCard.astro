---
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
const { data, collection = "dev" } = Astro.props;
const { title, description, date, categories = [] } = data.data;
---

<article class="post-card">
  <div class="post-meta">
    {date && <time datetime={date.toISOString()}>{dateFormat(date)}</time>}{
      categories
        .slice(0, 2)
        .map((category: string) => (
          <a href={`/${collection}/categories/${slugify(category)}`}>
            {humanize(category)}
          </a>
        ))
    }
  </div>
  <h3><a href={`/${collection}/${data.id}`}>{title}</a></h3>
  <p>{description || plainify(data.body?.slice(0, 200))}</p>
  <a
    class="post-read"
    href={`/${collection}/${data.id}`}
    aria-label={`Read ${title}`}>Read story <span aria-hidden="true">↗</span></a
  >
</article>
