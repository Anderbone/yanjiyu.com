---
import { translator, localeFrom, localePath } from "@/lib/i18n";

const locale = localeFrom(Astro.url);
const t = translator(Astro.url);

const { searchData } = Astro.props;
const pages = [
  { title: "Home", href: "/", group: "Page" },
  { title: "About", href: "/about", group: "Page" },
  { title: "Projects", href: "/projects", group: "Page" },
  { title: "CV", href: "/cv", group: "Page" },
  { title: "Dev", href: "/dev", group: "Page" },
  { title: "Journal", href: "/journal", group: "Page" },
  { title: "Contact", href: "/contact", group: "Page" },
  { title: "Privacy Policy", href: "/privacy-policy", group: "Page" },
  {
    title: "Terminal Spike Privacy Policy",
    href: "/projects/terminal-spike/privacy",
    group: "Page",
  },
];
const entries = [
  ...pages,
  ...searchData
    .filter((item: any) => item.group !== "page")
    .map((item: any) => ({
      title: item.frontmatter.title,
      href: `/${item.slug}`,
      group: item.group === "dev" ? "Dev" : "Journal",
      keywords: [
        item.frontmatter.description,
        ...(item.frontmatter.tags || []),
        ...(item.frontmatter.categories || []),
      ]
        .flatMap((keyword: string | undefined) =>
          keyword ? [keyword, t(keyword)] : [],
        )
        .join(" "),
    })),
];
---

<dialog class="command-palette" aria-labelledby="command-title">
  <div class="command-heading">
    <h2 id="command-title">{t("Go somewhere.")}</h2><button
      data-command-close
      aria-label={t("Close search")}><kbd>{t("Esc")}</kbd></button
    >
  </div>
  <label class="sr-only" for="command-input"
    >{t("Search pages and writing")}</label
  >
  <input
    id="command-input"
    type="search"
    placeholder={t("Search pages, projects, writing…")}
    autocomplete="off"
  />
  <p class="command-count" role="status" aria-live="polite"></p>
  <div class="command-results">
    {
      entries.map((entry) => (
        <a
          href={localePath(entry.href, locale)}
          data-command-result
          data-search={`${t(entry.title)} ${t(entry.group)} ${"keywords" in entry ? entry.keywords : ""}`.toLowerCase()}
        >
          <>
            <span>{t(entry.title)}</span>
            <small>{t(entry.group)}</small>
            <span aria-hidden="true">↗</span>
          </>
        </a>
      ))
    }
  </div>
  <p class="command-empty" hidden>
    {t("No matches. Try a topic like “Linux” or “AI”.")}
  </p>
  <div class="command-footer">
    <span
      ><kbd>↑</kbd> <kbd>↓</kbd> {t("navigate")} <kbd>↵</kbd> {t("open")}</span
    ><span>{t("Explore with curiosity.")}</span>
  </div>
</dialog>
