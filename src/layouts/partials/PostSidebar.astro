---
import { humanize } from "@/lib/utils/textConverter";
const { tags, categories, allCategories, collection = "dev" } = Astro.props;
---

<aside class="taxonomy-sidebar" aria-label="Browse this section">
  <section>
    <h2>Categories</h2><ul>
      {
        categories.map((category: string) => (
          <li>
            <a href={`/${collection}/categories/${category}`}>
              {humanize(category)}
              <span>
                {String(
                  allCategories.filter((c: string) => c === category).length,
                ).padStart(2, "0")}
              </span>
            </a>
          </li>
        ))
      }
    </ul><a class="taxonomy-all" href={`/${collection}/categories`}
      >All categories ↗</a>
  </section>
  <section>
    <h2>Explore topics</h2><div class="taxonomy-tags">
      {
        tags
          .slice(0, 18)
          .map((tag: string) => (
            <a href={`/${collection}/tags/${tag}`}>{humanize(tag)}</a>
          ))
      }
    </div><a class="taxonomy-all" href={`/${collection}/tags`}>All tags ↗</a>
  </section>
</aside>
