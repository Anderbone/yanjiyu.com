---
import { translator, localeFrom, localePath, stripLocale } from "@/lib/i18n";

const locale = localeFrom(Astro.url);
const t = translator(Astro.url);

import menu from "@/config/menu.json";
const path = stripLocale(Astro.url.pathname);
---

<header class="site-header">
  <div class="site-bar">
    <a
      href={localePath("/", locale)}
      class="wordmark"
      aria-label={t("Jiyu Yan home")}
      ><span class="brand-mark" aria-hidden="true">{t("jy")}<span>_</span></span
      ><span>{t("Jiyu Yan")}</span></a
    >
    <nav class="desktop-nav" aria-label={t("Main navigation")}>
      {
        menu.main.map((item, index) => (
          <a
            href={localePath(item.url, locale)}
            aria-current={
              (item.url === "/" ? path === "/" : path.startsWith(item.url))
                ? "page"
                : undefined
            }
          >
            <span class="nav-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            {t(item.name)}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <a
        class="language-toggle"
        data-language-switch
        href={localePath(Astro.url.pathname, locale === "zh" ? "en" : "zh")}
        hreflang={locale === "zh" ? "en" : "zh-CN"}
        lang={locale === "zh" ? "en" : "zh-CN"}
        aria-label={locale === "zh" ? "Switch to English" : "切换到中文"}
        >{locale === "zh" ? "EN" : "中文"}</a
      >
      <button
        class="command-trigger"
        data-command-open
        aria-label={t("Search pages and writing")}
        aria-keyshortcuts="Control+k Meta+k"
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4 4"
          ></path></svg
        ><kbd data-command-shortcut>{t("Ctrl K")}</kbd></button
      >
      <button
        class="theme-toggle"
        data-theme-toggle
        aria-label={t("Switch color theme")}
        title={t("Switch color theme")}
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="8"></circle><path d="M12 4v16"
          ></path><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"
          ></path></svg
        ></button
      >
      <button
        class="mobile-menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-navigation"
        >{t("Menu")} <span aria-hidden="true">+</span></button
      >
    </div>
  </div>
  <nav
    id="mobile-navigation"
    class="mobile-nav"
    aria-label={t("Mobile navigation")}
    hidden
  >
    {
      menu.main.map((item, index) => (
        <a
          href={localePath(item.url, locale)}
          aria-current={
            (item.url === "/" ? path === "/" : path.startsWith(item.url))
              ? "page"
              : undefined
          }
        >
          <span>0{index + 1}</span>
          {t(item.name)}
          <span aria-hidden="true">↗</span>
        </a>
      ))
    }
  </nav>
  <div class="reading-progress" aria-hidden="true"></div>
</header>
