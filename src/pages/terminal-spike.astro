---
import Base from "@/layouts/Base.astro";
import { localeFrom, localePath, translator } from "@/lib/i18n";
const locale = localeFrom(Astro.url);
const t = translator(Astro.url);
const play =
  "https://play.google.com/store/apps/details?id=com.yanjiyu.terminalspike";
const github = "https://github.com/Anderbone/terminal-spike";
const features = [
  {
    file: "projects",
    title: "Your projects, one tap away.",
    body: "Return to Herdr projects and running sessions. Move between workspaces without rebuilding your setup on a small screen.",
  },
  {
    file: "snippets",
    title: "Less typing. More doing.",
    body: "Keep commands and key sequences close to the keyboard. Save snippets, reorder them, and choose when to keep them visible.",
  },
  {
    file: "gestures",
    title: "A terminal that speaks touch.",
    body: "Navigate with touch, bring up the keyboard when you need it, and reach terminal keys without fighting your phone.",
  },
  {
    file: "typing",
    title: "Write comfortably. Send deliberately.",
    body: "Use the input area for longer prompts and commands, with terminal controls within reach. Your coding tools keep running on your own machine.",
  },
];
---

<Base
  title="Terminal Spike"
  description={t(
    "A native Android home for SSH, Mosh, Herdr and the work you already have running.",
  )}
>
  <div class="spike">
    <nav class="product-nav" aria-label="Terminal Spike">
      <a class="wordmark" href={localePath("/terminal-spike", locale)}
        ><img
          src="/images/terminal-spike-icon.svg"
          width="30"
          height="30"
          alt=""
        />Terminal Spike</a
      >
      <a href={github}>GitHub ↗</a>
    </nav>
    <section class="hero">
      <div class="hero-copy">
        <p class="kicker">ANDROID / SSH / MOSH</p>
        <h1>Terminal<br />Spike<span>_</span></h1>
        <h2>{t("Your terminal. Everywhere.")}</h2>
        <p class="lede">
          {
            t(
              "A native Android home for SSH, Mosh, Herdr and the work you already have running.",
            )
          }
        </p>
        <div class="actions">
          <a class="cta" href={play}>{t("Get it on Google Play ↗")}</a><a
            href="#workflow">{t("Explore the workflow")} ↓</a
          >
        </div>
        <p class="fine">{t("Android 8.0+ · Open source")}</p>
      </div>
      <figure class="hero-device">
        <video
          controls
          muted
          playsinline
          preload="metadata"
          poster="/images/terminal-spike-demo.webp"
          width="720"
          height="1680"
          aria-label={t(
            "Terminal Spike app demo: remote coding, scrolling, and tmux sessions",
          )}
          ><source
            src="/videos/terminal-spike-demo.mp4"
            type="video/mp4"
          /></video
        >
        <figcaption>{t("Real app recordings")}</figcaption>
      </figure>
      <div class="hero-index" aria-hidden="true">01 — TERMINAL, UNTETHERED</div>
    </section>
    <section id="workflow" class="workflow">
      <header class="section-heading">
        <p class="kicker">THE WORKFLOW</p><h2>
          {t("Built for your phone. Connected to your machine.")}
        </h2>
      </header>
      {
        features.map((feature, index) => (
          <section class:list={["feature", { reverse: index % 2 === 1 }]}>
            <div class="feature-copy">
              <>
                <span class="number">0{index + 1}</span>
                <h3>{t(feature.title)}</h3>
                <p>{t(feature.body)}</p>
              </>
            </div>
            <figure>
              <>
                <video
                  controls
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={`/images/terminal-spike/${feature.file}.webp`}
                  aria-label={t(feature.title)}
                >
                  <source
                    src={`/videos/terminal-spike/guide_${feature.file}.mp4`}
                    type="video/mp4"
                  />
                </video>
                <figcaption>
                  {t("Real app recordings")} / 0{index + 1}
                </figcaption>
              </>
            </figure>
          </section>
        ))
      }
    </section>
    <section class="capabilities">
      <h2>{t("The whole remote workflow.")}</h2><div class="details">
        <article>
          <span>01 / CONNECT</span><h3>{t("SSH + built-in Mosh")}</h3><p>
            {
              t(
                "Connect with passwords or keys. Use Mosh for changing networks; your host needs mosh-server.",
              )
            }
          </p>
        </article>
        <article>
          <span>02 / TRANSFER</span><h3>
            {t("Files, alongside your shell")}
          </h3><p>
            {
              t(
                "Browse and transfer files with SFTP. Send a clipboard image to your host and paste its remote path.",
              )
            }
          </p>
        </article>
        <article>
          <span>03 / WORK</span><h3>{t("Your tools, connected")}</h3><p>
            {
              t(
                "Open code-server, follow web and Obsidian links, and keep multiple terminal sessions in tabs.",
              )
            }
          </p>
        </article>
      </div>
    </section>
    <section class="privacy">
      <p class="kicker">LOCAL FIRST / OPEN SOURCE</p><h2>
        {t("Your machine. Your connection.")}
      </h2><p>
        {
          t(
            "No app account. No ads. No analytics. Saved credentials are encrypted with Android Keystore. Open source, so you can look inside.",
          )
        }
      </p><a href={localePath("/projects/terminal-spike/privacy", locale)}
        >{t("Privacy policy →")}</a
      >
    </section>
    <section class="download">
      <img
        src="/images/terminal-spike-icon.svg"
        width="64"
        height="64"
        alt=""
      /><h2>{t("Take your workspace with you.")}</h2><div class="actions">
        <a class="cta" href={play}>{t("Get it on Google Play ↗")}</a><a
          href={`${github}/releases`}>{t("Download APK")} ↗</a
        ><a href={github}>{t("View source ↗")}</a>
      </div><p class="fine">
        Terminal Spike · {t("Android 8.0+ · Open source")}
      </p>
    </section>
  </div>
</Base>
<style>
  .spike {
    --ink: #edf3ee;
    --muted: #a0aaa2;
    --accent: #b6f578;
    background: #0b100e;
    color: var(--ink);
    font-family: inherit;
  }
  .spike a {
    color: inherit;
    text-decoration: none;
  }
  .product-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 6%;
    border-bottom: 1px solid #ffffff18;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 650;
  }
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    min-height: 750px;
    padding: 65px 10% 90px;
    gap: 8%;
  }
  .kicker,
  .number,
  .details span,
  .hero-index {
    font: 12px monospace;
    letter-spacing: 0.15em;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(76px, 9vw, 145px);
    font-weight: 650;
    line-height: 0.91;
    letter-spacing: -0.075em;
    margin: 28px 0;
  }
  h1 span {
    color: var(--accent);
  }
  .hero h2 {
    font-size: clamp(22px, 2.5vw, 36px);
    letter-spacing: -0.04em;
    font-weight: 450;
  }
  .lede {
    max-width: 440px;
    color: var(--muted);
    line-height: 1.8;
    margin: 20px 0 30px;
  }
  .actions {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .spike .cta {
    background: var(--accent);
    color: #13200c;
    padding: 16px 23px;
    font-weight: 650;
    border-radius: 4px;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .cta:hover {
    transform: translateY(-3px);
    background: #ceffa1;
  }
  .fine {
    font: 12px monospace;
    color: var(--muted);
    margin-top: 24px;
  }
  .hero-device {
    margin: 0;
    justify-self: center;
    transform: rotate(3deg);
    animation: arrive 0.9s ease-out both;
  }
  .hero-device video {
    display: block;
    width: 260px;
    max-height: 570px;
    background: #050706;
    border: 6px solid #29342d;
    border-radius: 28px;
    box-shadow: 25px 35px 0 #b6f5780b;
  }
  .hero-device figcaption {
    margin: 20px;
    text-align: center;
    color: var(--muted);
    font: 11px monospace;
  }
  .hero-index {
    position: absolute;
    bottom: 25px;
    left: 6%;
    color: var(--muted);
  }
  .workflow,
  .capabilities,
  .privacy,
  .download {
    padding: 100px 10%;
  }
  .workflow {
    background: #111914;
    scroll-margin-top: 30px;
  }
  .section-heading {
    max-width: 720px;
    margin-bottom: 90px;
  }
  .spike h2 {
    color: var(--ink);
  }
  .section-heading h2,
  .capabilities > h2,
  .privacy h2,
  .download h2 {
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.15;
    letter-spacing: -0.045em;
    font-weight: 500;
    margin: 20px 0 30px;
  }
  .feature {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 12%;
    align-items: center;
    padding: 65px 0;
    border-top: 1px solid #ffffff1b;
  }
  .feature.reverse .feature-copy {
    order: 2;
  }
  .feature h3 {
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin: 25px 0;
  }
  .feature p,
  .details p,
  .privacy p {
    color: var(--muted);
    line-height: 1.85;
  }
  .feature figure {
    margin: 0;
    min-width: 0;
  }
  .feature video {
    width: 100%;
    max-height: 500px;
    background: #080d0a;
    object-fit: contain;
    border-radius: 6px;
  }
  .feature figcaption {
    font: 11px monospace;
    color: var(--muted);
    margin-top: 14px;
  }
  .details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 50px;
    margin-top: 60px;
  }
  .details h3 {
    font-size: 23px;
    color: var(--ink);
    margin: 24px 0 15px;
  }
  .privacy {
    border-block: 1px solid #ffffff1b;
    max-width: none;
  }
  .privacy p {
    max-width: 650px;
  }
  .privacy a {
    display: inline-block;
    margin-top: 24px;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 5px;
  }
  .download {
    text-align: center;
    background: #19241b;
  }
  .download img {
    margin: 0 auto 30px;
  }
  .download .actions {
    justify-content: center;
  }
  .download h2 {
    max-width: 700px;
    margin: 0 auto 40px;
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(25px) rotate(0);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(3deg);
    }
  }
  .hero-copy {
    animation: arrive-copy 0.7s ease-out both;
  }
  @keyframes arrive-copy {
    from {
      opacity: 0;
      translate: 0 15px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-device,
    .hero-copy {
      animation: none;
    }
    .cta {
      transition: none;
    }
  }
  @media (min-width: 900px) {
    .feature-copy {
      position: sticky;
      top: 100px;
    }
  }
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 50px 7% 70px;
      gap: 50px;
      min-height: 0;
    }
    .hero h1 {
      font-size: 88px;
    }
    .hero-device {
      transform: none;
    }
    .hero-device video {
      width: 240px;
      max-height: 540px;
    }
    .hero-index {
      display: none;
    }
    .workflow,
    .capabilities,
    .privacy,
    .download {
      padding: 65px 7%;
    }
    .section-heading {
      margin-bottom: 45px;
    }
    .feature {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 45px 0;
    }
    .feature.reverse .feature-copy {
      order: 0;
    }
    .details {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .actions {
      gap: 20px;
    }
    .feature video {
      max-height: 440px;
    }
  }
</style>
