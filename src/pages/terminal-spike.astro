<script>
  function fitRecordedLayouts() {
    document
      .querySelectorAll<HTMLElement>(".hero-shot, .combined-layouts")
      .forEach((figure) => {
        const video = figure.querySelector("video");
        if (!video || figure.dataset.fitted) return;
        figure.dataset.fitted = "true";
        const fit = () => {
          figure.dataset.scene =
            video.currentTime < 10
              ? "phone"
              : video.currentTime < 12
                ? "keys"
                : "wide";
        };
        video.addEventListener("timeupdate", fit);
        video.addEventListener("seeking", fit);
        video.addEventListener("loadedmetadata", fit);
        fit();
      });
  }
  fitRecordedLayouts();
  document.addEventListener("astro:page-load", fitRecordedLayouts);
</script>

