<script>
  function setupGallery() {
    const gallery = document.querySelector<HTMLElement>(".steps");
    if (!gallery || gallery.dataset.ready) return;
    gallery.dataset.ready = "true";
    const move = (direction: number) =>
      gallery.scrollBy({
        left:
          direction *
          ((gallery.firstElementChild as HTMLElement).offsetWidth + 32),
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "instant"
          : "smooth",
      });
    document
      .querySelector("[data-gallery-prev]")
      ?.addEventListener("click", () => move(-1));
    document
      .querySelector("[data-gallery-next]")
      ?.addEventListener("click", () => move(1));
    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        event.preventDefault();
        move(event.key === "ArrowRight" ? 1 : -1);
      }
    });
  }
  setupGallery();
  document.addEventListener("astro:page-load", setupGallery);
</script>
