<script>
  function controlMotion() {
    const button = document.querySelector<HTMLButtonElement>(
      "[data-pause-motion]",
    );
    if (!button || button.dataset.ready) return;
    button.dataset.ready = "true";
    const preference = matchMedia("(prefers-reduced-motion: reduce)");
    const update = (paused: boolean) => {
      document
        .querySelectorAll<HTMLImageElement>(".auto-motion")
        .forEach((img) => {
          img.src = (paused ? img.dataset.still : img.dataset.motion)!;
          const source = img.closest("picture")?.querySelector("source");
          if (source) source.srcset = img.src;
        });
      button.setAttribute("aria-pressed", String(paused));
      button.textContent = (
        paused ? button.dataset.resume : button.dataset.pause
      )!;
    };
    button.addEventListener("click", () =>
      update(button.getAttribute("aria-pressed") !== "true"),
    );
    preference.addEventListener("change", () => update(preference.matches));
    update(preference.matches);
  }
  controlMotion();
  document.addEventListener("astro:page-load", controlMotion);
</script>

