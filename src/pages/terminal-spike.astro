---
import Base from "@/layouts/Base.astro";
import { localeFrom, localePath, translator } from "@/lib/i18n";
const locale = localeFrom(Astro.url);
const t = translator(Astro.url);
const repo = "https://github.com/Anderbone/terminal-spike";
const docs = repo + "/blob/38fba27/docs/";
const play =
  "https://play.google.com/store/apps/details?id=com.yanjiyu.terminalspike";
---

<Base
  product
  title="Terminal Spike"
  description="A free, open-source Android terminal for SSH and Mosh. Your existing workflow, with room to make it yours."
  image="/images/terminal-spike/highlights-poster.webp"
>
  <div class="spike">
    <nav class="nav wrap" aria-label="Terminal Spike">
      <a class="brand" href={localePath("/terminal-spike", locale)}
        ><img
          src="/images/terminal-spike-icon.svg"
          width="28"
          height="28"
          alt=""
        />Terminal Spike</a
      >
      <div>
        <a class="nav-guide" href={docs + "HERDR-SETUP.md"}>{t("Guide")}</a><a
          data-language-switch
          href={localePath("/terminal-spike", locale === "en" ? "zh" : "en")}
          lang={locale === "en" ? "zh-CN" : "en"}
          >{locale === "en" ? "简体中文" : "English"}</a
        ><a class="nav-get" href={play}>{t("Get it free")} ↗</a>
      </div>
    </nav>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">{t("FREE & OPEN SOURCE · NATIVE ANDROID")}</p>
        <h1>
          {t("A small app.")}<br /><span>{t("Your whole workflow.")}</span>
        </h1>
        <p class="intro">
          {
            t(
              "Free, open-source SSH and Mosh for Android. Your shell, your agents, your workflow — on your phone.",
            )
          }
        </p>
        <div class="actions">
          <a class="button" href={play}>{t("Get it free")} <span>↗</span></a><a
            class="source"
            href={repo}>{t("View source")} ↗</a
          >
        </div>
        <p class="small">{t("No app account. No ads. No subscription.")}</p>
        <p class="micro">
          {t("Lightweight native app")}
          <span> / </span> Android 8.0+
        </p>
      </div>
      <figure class="hero-shot" data-scene="phone">
        <div class="media-stage">
          <div class="device">
            <video
              data-highlights
              controls
              muted
              playsinline
              loop
              preload="metadata"
              width="900"
              height="1000"
              poster="/images/terminal-spike/highlights-poster.webp"
              aria-label={t(
                "Terminal Spike in action: agents, attachments and your remote editor",
              )}
              ><source
                src="/videos/terminal-spike/highlights.mp4"
                type="video/mp4"
              /></video
            >
          </div>
        </div><figcaption>
          {t("Herdr navigation. Your terminal. The whole view.")}
        </figcaption>
      </figure>
    </section>

    <div class="wrap motion-controls">
      <button
        type="button"
        data-pause-motion
        aria-pressed="false"
        data-pause={t("Pause animations")}
        data-resume={t("Resume animations")}>{t("Pause animations")}</button
      >
    </div>
    <section class="wrap section setup" id="setup">
      <div class="section-copy">
        <p class="eyebrow">01 / SSH · MOSH · TMUX · HERDR</p><h2
          set:html={t("A thin layer.<br/>All your freedom.")}
        /><p>
          {
            t(
              "Keep your shell, tmux, Herdr and agents. Customise your remote workspace; Terminal Spike brings it to your phone with native touch controls.",
            )
          }
        </p><a class="text-link" href={docs + "HERDR-SETUP.md"}
          >{t("Set up Herdr for your phone")} ↗</a
        >
      </div><figure class="workspace motion-workspace">
        <picture
          ><source
            media="(prefers-reduced-motion: reduce)"
            srcset="/images/terminal-spike/workspace-poster.webp"
          /><img
            class="auto-motion"
            data-motion="/images/terminal-spike/workspace-motion-v2.webp"
            data-still="/images/terminal-spike/workspace-poster.webp"
            src="/images/terminal-spike/workspace-motion-v2.webp"
            width="540"
            height="600"
            loading="lazy"
            alt={t("Herdr agent conversation and workspace navigation")}
          /></picture
        ><figcaption>{t("Herdr · remote workflow detail")}</figcaption>
      </figure>
    </section>
    <section class="workflow section" id="workflow">
      <div class="wrap">
        <p class="eyebrow">02 / {t("CONTEXT → CHANGES → EDITOR")}</p><h2
          set:html={t("Send. Review. Keep going.")}
        />
        <div class="gallery-controls">
          <span>{t("Swipe to explore")}</span><div>
            <button
              type="button"
              data-gallery-prev
              aria-label={t("Previous screen")}>←</button
            ><button
              type="button"
              data-gallery-next
              aria-label={t("Next screen")}>→</button
            >
          </div>
        </div>
        <div
          class="steps"
          tabindex="0"
          role="region"
          aria-label={t("Workflow screens")}
        >
          <article>
            <p class="eyebrow">A / {t("SEND")}</p><h3
              set:html={t("Show your agent<br/>what you mean.")}
            /><p>
              {
                t(
                  "Send images and files to your host. Insert their paths for your agent to use.",
                )
              }
            </p><figure>
              <picture
                ><source
                  media="(prefers-reduced-motion: reduce)"
                  srcset="/images/terminal-spike/upload-poster.webp"
                /><img
                  class="auto-motion"
                  data-motion="/images/terminal-spike/upload-motion-v2.webp"
                  data-still="/images/terminal-spike/upload-poster.webp"
                  src="/images/terminal-spike/upload-motion-v2.webp"
                  width="540"
                  height="600"
                  loading="lazy"
                  alt={t(
                    "Attach an image and insert its path into the terminal",
                  )}
                /></picture
              ><figcaption>{t("Image → remote path → agent")}</figcaption>
            </figure>
          </article>
          <article>
            <p class="eyebrow">B / {t("REVIEW")}</p><h3
              set:html={t("See exactly<br/>what changed.")}
            /><p>
              {
                t(
                  "Read Git changes in the native Android diff viewer. No editor setup needed.",
                )
              }
            </p><figure>
              <img
                class="portrait-capture"
                src="/images/terminal-spike/project.webp"
                width="900"
                height="1600"
                loading="lazy"
                alt={t("Native diff of src/tasks.js in the Atlas project")}
              /><figcaption>
                {t("Native Android diff viewer")}
              </figcaption>
            </figure>
          </article>
          <article>
            <p class="eyebrow">C / {t("CONTINUE")}</p><h3
              set:html={t("Your editor is<br/>one tab away.")}
            /><p>
              {
                t(
                  "Open your own code-server in a tab. Edit, then return to the terminal.",
                )
              }
            </p><figure>
              <picture
                ><source
                  media="(prefers-reduced-motion: reduce)"
                  srcset="/images/terminal-spike/editor-poster.webp"
                /><img
                  class="auto-motion"
                  data-motion="/images/terminal-spike/editor-motion-v2.webp"
                  data-still="/images/terminal-spike/editor-poster.webp"
                  src="/images/terminal-spike/editor-motion-v2.webp"
                  width="540"
                  height="600"
                  loading="lazy"
                  alt={t(
                    "Switch from the terminal to an existing code-server editor",
                  )}
                /></picture
              ><figcaption>{t("Your existing code-server")}</figcaption>
            </figure>
          </article>
        </div><a class="text-link" href={docs + "PROJECT-REVIEW.md"}
          >{t("Native review guide")} ↗</a
        ><a class="text-link adjacent" href={docs + "EMBEDDED-BROWSER.md"}
          >{t("Connect code-server")} ↗</a
        >
      </div>
    </section>
    <section class="linux section">
      <div class="wrap linux-inner">
        <figure class="arch-media">
          <picture
            ><source
              media="(prefers-reduced-motion: reduce)"
              srcset="/images/terminal-spike/arch-settings-poster.webp"
            /><img
              class="auto-motion"
              data-motion="/images/terminal-spike/arch-settings-motion-v2.webp"
              data-still="/images/terminal-spike/arch-settings-poster.webp"
              src="/images/terminal-spike/arch-settings-motion-v2.webp"
              width="540"
              height="600"
              loading="lazy"
              alt={t("Local Arch settings and local agent access")}
            /></picture
          >
        </figure>
        <p class="eyebrow">03 / {t("OPTIONAL · ON YOUR PHONE")}</p><h2
          set:html={t("Linux. On your phone.")}
        /><p class="section-intro">
          {
            t(
              "Install optional Arch Linux. Run shell tools and compatible agent CLIs locally. No Android root needed.",
            )
          }
        </p><p class="micro">
          {t("ARM64 devices. Additional download and storage required.")}
        </p><p class="small">
          {
            t(
              "Linux downloads separately. Third-party AI services may charge their own fees.",
            )
          }
        </p><a class="text-link" href={docs + "local-arch-linux.md"}
          >{t("Install Local Arch")} ↗</a
        >
      </div>
    </section>
    <section class="wrap section personal">
      <div>
        <p class="eyebrow">04 / {t("OPTIONAL · LOCAL AGENT")}</p><h2
          set:html={t("Make it yours.<br/>Just ask.")}
        /><p>
          {
            t(
              "Make the app fit you: shortcuts, connection profiles, colours, fonts and input settings. Change them yourself, or ask a local agent.",
            )
          }
        </p><blockquote>
          {t("“Add a git status shortcut. Make the text larger.”")}
        </blockquote><p class="small">
          {
            t(
              "After installing Local Arch, enable local settings access. Then chat with a compatible agent to change supported app settings.",
            )
          }
        </p><a class="text-link" href={docs + "local-agent-control.md"}
          >{t("Supported settings & setup")} ↗</a
        >
      </div><figure class="shortcut-shot">
        <picture
          ><source
            media="(prefers-reduced-motion: reduce)"
            srcset="/images/terminal-spike/local-agent-poster.webp"
          /><img
            class="auto-motion"
            data-motion="/images/terminal-spike/local-agent-motion-v2.webp"
            data-still="/images/terminal-spike/local-agent-poster.webp"
            src="/images/terminal-spike/local-agent-motion-v2.webp"
            width="540"
            height="600"
            loading="lazy"
            alt={t("A local agent reads the supported app settings controls")}
          /></picture
        ><figcaption>{t("Ask locally. Choose what to change.")}</figcaption>
      </figure>
    </section>
    <section class="wrap section network lean-network">
      <p class="eyebrow">Tailscale · Mosh · tmux · Herdr</p>
      <h2>{t("Good tools. Already yours.")}</h2>
      <p>
        {
          t(
            "We don’t reinvent them. Use Tailscale to reach your computer, Mosh for changing networks, and tmux or Herdr to keep sessions running.",
          )
        }
      </p>
      <p class="small">
        {t("Choose your tools. Keep your host online. Stay in control.")}
      </p>
      <a class="text-link" href="https://tailscale.com/">Tailscale ↗</a>
    </section>
    <section class="download section" id="download">
      <div class="wrap">
        <img
          src="/images/terminal-spike-icon.svg"
          width="56"
          height="56"
          alt=""
        /><p class="eyebrow">{t("FREE. OPEN. YOURS.")}</p><h2
          set:html={t("Your terminal.<br/>On your terms.")}
        /><div class="actions">
          <a class="button" href={play}>{t("Get it free")} ↗</a><a
            class="source"
            href={repo}>{t("View source")} ↗</a
          >
        </div><p class="small">
          {t("Google Play · 0.0.14 · Android 8.0+")}
        </p><div class="resources">
          <a href={repo + "/releases"}>Releases ↗</a><a href={repo + "/issues"}
            >Issues ↗</a
          ><a href={repo + "/blob/main/LICENSE"}>GPL-3.0 ↗</a><a
            href={docs + "HERDR-SETUP.md"}>{t("Setup guide")} ↗</a
          ><a href={localePath("/projects/terminal-spike/privacy", locale)}
            >{t("Privacy policy")} ↗</a
          >
        </div>
      </div>
    </section>
    <footer class="wrap">
      <a class="brand" href={localePath("/terminal-spike", locale)}
        >Terminal Spike</a
      ><a href="https://discord.gg/yMPzeCeWMT">{t("Join Discord")} ↗</a><a
        href={localePath("/about", locale)}>{t("Made by Jiyu Yan")} ↗</a
      ><span>{t("Your existing workflow. Room to make it yours.")}</span>
    </footer>
  </div>
</Base>
<style>
  .spike {
    background: #0b0f10;
    color: #edf4f1;
    font-family: Arial, "Noto Sans", sans-serif;
    --mint: #86d8be;
    --muted: #a5b6b1;
    --line: #2a3735;
    line-height: 1.65;
  }
  .spike :is(h1, h2, h3, p, figure, blockquote) {
    margin: 0;
  }
  .spike :is(h1, h2, h3) {
    color: #edf4f1;
    font-family: inherit;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .spike a {
    color: inherit;
    text-decoration: none;
  }
  .spike a:hover {
    color: var(--mint);
  }
  .spike a:focus-visible,
  .spike summary:focus-visible,
  .spike video:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 6px;
  }
  .wrap {
    width: min(1200px, calc(100% - 96px));
    margin-inline: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 96px;
    border-bottom: 1px solid var(--line);
    gap: 20px;
  }
  .brand {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .nav > div {
    display: flex;
    gap: 28px;
    align-items: center;
    font-size: 13px;
  }
  .nav a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .nav-get {
    border: 1px solid #52695f;
    border-radius: 6px;
    padding: 0 18px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 70px;
    padding-block: 88px 100px;
  }
  .eyebrow {
    font:
      11px/1.7 ui-monospace,
      monospace;
    letter-spacing: 0.13em;
    color: var(--mint);
    margin-bottom: 26px !important;
  }
  .hero h1 {
    font-size: clamp(45px, 5.5vw, 78px);
    line-height: 1.04;
    letter-spacing: -0.055em;
  }
  .hero h1 span {
    color: var(--mint);
  }
  .intro {
    font-size: 18px;
    color: #b6c6c0;
    max-width: 510px;
    margin-top: 28px !important;
    line-height: 1.65;
  }
  .actions {
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
    margin-block: 32px 20px;
  }
  .button {
    display: inline-flex;
    justify-content: space-between;
    gap: 45px;
    align-items: center;
    background: var(--mint);
    color: #0b1914 !important;
    padding: 15px 24px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    min-height: 52px;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .button:hover {
    background: #b1ecd8;
    transform: translateY(-2px);
  }
  .source {
    padding: 12px 0;
    min-height: 48px;
    font-size: 14px;
    border-bottom: 1px solid #61716a;
  }
  .small {
    font-size: 13px !important;
    line-height: 1.8 !important;
    color: var(--muted);
    margin-top: 22px !important;
  }
  .micro {
    font:
      11px/1.8 ui-monospace,
      monospace;
    color: var(--muted);
    margin-top: 30px !important;
  }
  .micro span {
    padding-inline: 10px;
    color: var(--line);
  }
  .hero-shot {
    position: relative;
    max-width: 340px;
    justify-self: center;
    animation: arrive 0.8s ease-out both;
  }
  .device {
    padding: 8px;
    border: 1px solid #41514a;
    border-radius: 23px;
    background: #050808;
    box-shadow: 22px 25px 0 #121a1c;
  }
  .device img {
    border-radius: 16px;
    width: 100%;
    height: auto;
  }
  .hero-shot figcaption {
    margin-top: 42px;
    text-align: center;
  }
  .spike figcaption {
    font:
      11px/1.7 ui-monospace,
      monospace;
    color: var(--muted);
  }
  .principles {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-block: 1px solid var(--line);
    padding-block: 24px;
    color: var(--muted);
    font:
      12px/1.6 ui-monospace,
      monospace;
  }
  .section {
    padding-block: 120px;
  }
  .spike h2 {
    font-size: clamp(37px, 4.6vw, 64px);
  }
  .spike h3 {
    font-size: 28px;
  }
  .section-copy > p:not(.eyebrow),
  .personal > div > p:not(.eyebrow) {
    margin-top: 26px;
    color: var(--muted);
  }
  .setup,
  .personal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 120px;
    align-items: center;
  }
  .workspace {
    justify-self: center;
    width: min(100%, 355px);
  }
  .workspace img {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .workspace figcaption {
    margin-top: 20px;
  }
  .text-link {
    display: inline-block;
    padding-block: 14px;
    margin-top: 18px;
    border-bottom: 1px solid #56796c;
    color: var(--mint) !important;
    font-size: 14px;
  }
  .workflow {
    background: #121a1c;
    border-block: 1px solid var(--line);
  }
  .section-intro {
    font-size: 19px;
    color: var(--muted);
    max-width: 650px;
    margin-top: 25px !important;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
    margin-top: 65px;
  }
  .steps article {
    min-width: 0;
  }
  .steps .eyebrow {
    border-top: 1px solid #42544c;
    padding-top: 22px;
    margin-bottom: 18px !important;
  }
  .steps article > p:not(.eyebrow) {
    font-size: 15px;
    color: var(--muted);
    margin-top: 22px;
    min-height: 180px;
  }
  .steps figure {
    margin-top: 28px;
  }
  .steps img {
    border: 1px solid #384a43;
    border-radius: 12px;
    width: 100%;
    height: auto;
  }
  .steps figcaption {
    margin-top: 16px;
  }
  .adjacent {
    margin-left: 25px;
  }
  .personal blockquote {
    border-left: 2px solid var(--mint);
    padding: 8px 0 8px 24px;
    font-size: 23px;
    line-height: 1.5;
    color: #d2e7df;
    margin-top: 36px;
  }
  .shortcut-shot {
    max-width: 320px;
    justify-self: center;
  }
  .shortcut-shot img {
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .shortcut-shot figcaption {
    margin-top: 16px;
  }
  .linux {
    background: #15231f;
    border-block: 1px solid #2b4037;
  }
  .linux-inner {
    max-width: 850px;
  }
  .linux .small {
    max-width: 700px;
  }
  .network h2 {
    margin-bottom: 55px;
  }
  .network-rows > div {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 40px;
    border-top: 1px solid var(--line);
    padding: 30px 0;
    align-items: baseline;
  }
  .network-rows p {
    color: var(--muted);
  }
  .faq {
    padding-top: 0;
  }
  .faq h2 {
    margin-bottom: 45px;
  }
  .faq details {
    border-top: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    padding: 23px 0;
    font-size: 18px;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 25px;
  }
  .faq summary:after {
    content: "+";
    color: var(--mint);
    font-family: monospace;
  }
  .faq details[open] summary:after {
    content: "−";
  }
  .faq details p {
    max-width: 820px;
    color: var(--muted);
    padding: 0 35px 25px 0;
  }
  .download {
    border-top: 1px solid var(--line);
    background: #121a1c;
    text-align: center;
  }
  .download img {
    margin: 0 auto 25px;
  }
  .download .actions {
    justify-content: center;
  }
  .download .small {
    max-width: 700px;
    margin-inline: auto;
  }
  .resources {
    display: flex;
    gap: 28px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 38px;
    font-size: 13px;
  }
  .resources a {
    padding-block: 10px;
  }
  .spike footer {
    display: flex;
    gap: 25px;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding-block: 32px;
  }
  .spike footer > a:not(.brand),
  .spike footer span {
    font-size: 12px;
    color: var(--muted);
  }
  .hero-copy {
    animation: arrive 0.6s ease-out both;
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (min-width: 1000px) {
    .setup .section-copy {
      position: sticky;
      top: 50px;
      align-self: start;
      padding-top: 80px;
    }
  }
  @media (max-width: 1000px) {
    .wrap {
      width: calc(100% - 64px);
    }
    .hero {
      gap: 40px;
    }
    .hero h1 {
      font-size: 52px;
    }
    .setup,
    .personal {
      gap: 55px;
    }
    .steps {
      gap: 24px;
    }
    .steps article > p:not(.eyebrow) {
      min-height: 235px;
    }
    .section {
      padding-block: 85px;
    }
    .faq {
      padding-top: 0;
    }
    .hero-shot {
      max-width: 280px;
    }
    .principles {
      flex-wrap: wrap;
    }
    .principles span {
      width: 45%;
    }
  }
