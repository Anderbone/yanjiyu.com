---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import dateFormat from "@/lib/utils/dateFormat";
const posts = sortByDate(await getSinglePage("dev"));
const featuredPosts = [
  ...posts.filter((p) => p.data.pinned),
  ...posts.filter((p) => !p.data.pinned),
].slice(0, 3);
---

<Base>
  <section class="home-opening" aria-labelledby="home-title">
    <figure class="fencing-stage">
      <img
        src="/images/fencer.jpg"
        alt="A fencer suspended mid-leap, foil extended."
        width="640"
        height="640"
        fetchpriority="high"
      />
    </figure>
    <div class="home-introduction">
      <h1 id="home-title">Hi, I’m Jiyu.</h1>
      <p>
        A software engineer in Wrexham, UK.<br />I build useful products,
        integrations, and developer tools.
      </p>
      <div class="home-introduction-links">
        <a class="text-link" href="#selected-work"
          >Explore my work <span aria-hidden="true">↓</span></a
        ><a class="text-link" href="/about"
          >About me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section id="selected-work" class="site-width home-work section-space">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">01 / Selected work</p><h2>
          From idea to everyday use.
        </h2>
      </div><a class="text-link" href="/projects"
        >All projects <span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="work-grid">
      <a class="work-preview" href="/projects#terminal-spike" data-reveal
        ><div class="work-image terminal-preview">
          <span class="preview-label">Terminal Spike / Android</span><span
            class="terminal-type"
            aria-hidden="true">Your terminal.<br />Anywhere<span>_</span></span
          ><img
            src="/images/terminal-spike-demo.webp"
            width="720"
            height="1680"
            alt="Terminal Spike running a remote coding session on Android"
            loading="lazy"
          /><span class="preview-arrow" aria-hidden="true">↗</span>
        </div><div class="work-caption">
          <h3>Terminal Spike</h3><span>Android · SSH · Developer tools</span>
        </div><p>A remote workspace that fits in your pocket.</p></a
      >
      <a class="work-preview" href="/projects#opsdesk-ai" data-reveal
        ><div class="work-image opsdesk-preview">
          <span class="preview-label">OpsDesk AI / Product demo</span><img
            src="/images/opsdesk-ai-preview.png"
            width="1265"
            height="1826"
            alt="OpsDesk AI service desk with enquiry triage and human approval controls"
            loading="lazy"
          /><span class="preview-arrow" aria-hidden="true">↗</span>
        </div><div class="work-caption">
          <h3>OpsDesk AI</h3><span>AI · Operations · Full stack</span>
        </div><p>AI-assisted operations with people in control.</p></a
      >
    </div>
    <a class="project-strip" href="/projects#ralph-loop" data-reveal
      ><span class="mono strip-icon" aria-hidden="true">&gt;_</span><div>
        <h3>Ralph Loop</h3><p>
          Reviewed plans. Focused agent runs. A calmer development loop.
        </p>
      </div><span class="mono strip-meta">TypeScript / CLI</span><span
        class="strip-arrow"
        aria-hidden="true">↗</span
      ></a
    >
  </section>
  <section class="site-width section-space">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">02 / From the workbench</p><h2>
          Things learned along the way.
        </h2>
      </div><a class="text-link" href="/dev"
        >All Dev posts <span aria-hidden="true">↗</span></a
      >
    </div><div class="home-writing">
      {
        featuredPosts.map((post) => (
          <a href={`/dev/${post.id}`} class="writing-row" data-reveal>
            <>
              <time datetime={post.data.date?.toISOString()}>
                {dateFormat(post.data.date)}
              </time>
              <div>
                <>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </>
              </div>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        ))
      }
    </div><div class="journal-note">
      <span class="mono">Beyond the code</span><p>
        Books, faith, and a few observations on being human.
      </p><a class="text-link" href="/journal">Visit the Journal ↗</a>
    </div>
  </section>
</Base>
