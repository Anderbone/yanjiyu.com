---
import { translator, localeFrom, localePath } from "@/lib/i18n";

const locale = localeFrom(Astro.url);
const t = translator(Astro.url);

import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import dateFormat from "@/lib/utils/dateFormat";
const posts = sortByDate(await getSinglePage("dev", locale));
const featuredPosts = [
  ...posts.filter((p) => p.data.pinned),
  ...posts.filter((p) => !p.data.pinned),
].slice(0, 3);
---

<Base>
  <section class="home-opening" aria-labelledby="home-title">
    <figure class="fencing-stage">
      <img
        src="/images/fencer.jpg"
        alt={t("A fencer suspended mid-leap, foil extended.")}
        width="640"
        height="640"
        fetchpriority="high"
      />
    </figure>
    <div class="home-introduction">
      <h1 id="home-title">{t("Hi, I’m Jiyu.")}</h1>
      <p>
        {t("A software engineer in Wrexham, UK.")}<br />{
          t("I build useful products, integrations, and developer tools.")
        }
      </p>
      <div class="home-introduction-links">
        <a class="text-link" href="#selected-work"
          >{t("Explore my work")} <span aria-hidden="true">↓</span></a
        ><a class="text-link" href={localePath("/about", locale)}
          >{t("About me")} <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
  <section id="selected-work" class="site-width home-work section-space">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">{t("01 / Selected work")}</p><h2>
          {t("From idea to everyday use.")}
        </h2>
      </div><a class="text-link" href={localePath("/projects", locale)}
        >{t("All projects")} <span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="work-grid">
      <a
        class="work-preview"
        href={localePath("/projects#terminal-spike", locale)}
        data-reveal
        ><div class="work-image terminal-preview">
          <span class="preview-label">{t("Terminal Spike / Android")}</span
          ><span class="terminal-type" aria-hidden="true"
            >{t("Your terminal.")}<br />{t("Anywhere")}<span>_</span></span
          ><img
            src="/images/terminal-spike-demo.webp"
            width="720"
            height="1680"
            alt={t("Terminal Spike running a remote coding session on Android")}
            loading="lazy"
          /><span class="preview-arrow" aria-hidden="true">↗</span>
        </div><div class="work-caption">
          <h3>{t("Terminal Spike")}</h3><span
            >{t("Android · SSH · Developer tools")}</span
          >
        </div><p>
          {t("Herdr, remote agents, and a terminal that goes with me.")}
        </p></a
      >
      <a
        class="work-preview"
        href={localePath("/dev/pi-edge", locale)}
        data-reveal
      >
        <div class="work-image pi-edge-preview">
          <span class="preview-label">{t("Pi Edge / Obsidian")}</span>
          <img
            src="/images/pi-edge-obsidian.webp"
            width="2256"
            height="2408"
            alt={t("Pi Edge conversation beside a project note in Obsidian")}
            loading="lazy"
          />
          <span class="preview-arrow" aria-hidden="true">↗</span>
        </div>
        <div class="work-caption">
          <h3>{t("Pi Edge")}</h3><span>{t("Obsidian · Pi · Mobile")}</span>
        </div>
        <p>{t("Work with Pi on my computer, right beside my notes.")}</p>
      </a>
    </div>
    <a
      class="project-strip"
      href={localePath("/dev/workflow-anywhere", locale)}
      data-reveal
    >
      <span class="mono strip-icon" aria-hidden="true">↔</span>
      <div>
        <h3>{t("My anywhere workflow")}</h3><p>
          {
            t(
              "Herdr, code-server, Obsidian, and Pi Edge. Connected through Tailscale.",
            )
          }
        </p>
      </div>
      <span class="mono strip-meta">{t("Tools / Workflow")}</span><span
        class="strip-arrow"
        aria-hidden="true">↗</span
      >
    </a>
    <a
      class="project-strip"
      href={localePath("/projects#ralph-loop", locale)}
      data-reveal
      ><span class="mono strip-icon" aria-hidden="true">{t("&gt;_")}</span><div>
        <h3>{t("Ralph Loop")}</h3><p>
          {t("Reviewed plans. Focused agent runs. A calmer development loop.")}
        </p>
      </div><span class="mono strip-meta">{t("TypeScript / CLI")}</span><span
        class="strip-arrow"
        aria-hidden="true">↗</span
      ></a
    >
  </section>
  <section class="site-width section-space">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">{t("02 / From the workbench")}</p><h2>
          {t("Things learned along the way.")}
        </h2>
      </div><a class="text-link" href={localePath("/dev", locale)}
        >{t("All Dev posts")} <span aria-hidden="true">↗</span></a
      >
    </div><div class="home-writing">
      {
        featuredPosts.map((post) => (
          <a
            href={localePath(`/dev/${post.id}`, locale)}
            class="writing-row"
            data-reveal
          >
            <>
              <time datetime={post.data.date?.toISOString()}>
                {dateFormat(
                  post.data.date,
                  locale === "zh" ? "yyyy年M月d日" : undefined,
                )}
              </time>
              <div>
                <>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </>
              </div>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        ))
      }
    </div><div class="journal-note">
      <span class="mono">{t("Beyond the code")}</span><p>
        {t("Books, faith, and a few observations on being human.")}
      </p><a class="text-link" href={localePath("/journal", locale)}
        >{t("Visit the Journal ↗")}</a
      >
    </div>
  </section>
</Base>
