---
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify } from "@/lib/utils/textConverter";

const homepage = await getListPage("homepage", "-index");
const devPosts = await getSinglePage("dev");
const journalPosts = await getSinglePage("journal");
const posts = sortByDate([
  ...devPosts.map((post) => ({ ...post, collection: "dev" })),
  ...journalPosts.map((post) => ({ ...post, collection: "journal" })),
]);
const pinnedPosts = posts.filter((post) => post.data.pinned);
const latestPosts = posts.filter((post) => !post.data.pinned);
const featuredPosts = [...pinnedPosts, ...latestPosts].slice(0, 3);
const hasPinnedPosts = pinnedPosts.length > 0;

const { banner } = homepage.data;
---

<Base>
  <section class="section">
    <div class="container">
      <div class="row items-center justify-center gap-y-10">
        <div class="md:col-7 lg:col-6 text-center md:text-left">
          <h1
            set:html={markdownify(banner.title)}
            class="mb-4 text-h3 lg:text-h1"
          />
          <p set:html={markdownify(banner.content)} class="mb-8" />
          {
            banner.button.enable && (
              <a
                class="btn btn-primary"
                href={banner.button.link}
                target={
                  banner.button.link.startsWith("http") ? "_blank" : "_self"
                }
                rel="noopener"
              >
                {banner.button.label}
              </a>
            )
          }
        </div>
        <div class="md:col-5 lg:col-4">
          <img
            src="/images/fencer.jpg"
            alt="Fencer in motion"
            width="640"
            height="640"
            class="mx-auto aspect-square w-full max-w-[280px] rounded border border-border object-cover shadow-sm dark:border-darkmode-border md:max-w-[340px]"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
      <div class="row justify-center pt-12">
        <div class="md:col-10 lg:col-8">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="mb-2 text-sm font-medium uppercase text-primary">
                Writing
              </p>
              <h2 class="h3">
                {hasPinnedPosts ? "Pinned and latest" : "Latest posts"}
              </h2>
            </div>
          </div>
          <div class="divide-y divide-border dark:divide-darkmode-border">
            {
              featuredPosts.map((post) => (
                <a
                  class="group block py-5 first:pt-0 last:pb-0"
                  href={`/${post.collection}/${post.id}`}
                >
                  <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-light dark:text-darkmode-text-light">
                    <span class="font-medium text-primary">
                      {post.collection === "dev" ? "Dev" : "Journal"}
                    </span>
                    {post.data.pinned && <span>Pinned</span>}
                    {post.data.date && (
                      <time>{dateFormat(post.data.date)}</time>
                    )}
                  </div>
                  <h3 class="h5 mb-2 transition group-hover:text-primary">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-sm text-text-light dark:text-darkmode-text-light">
                      {post.data.description}
                    </p>
                  )}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
