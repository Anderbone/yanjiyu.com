---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import WorkflowMap from "@/components/WorkflowMap.astro";
import TerminalSpikeDemo from "@/components/TerminalSpikeDemo.astro";
---

<Base
  title="Projects — Jiyu Yan"
  description="Selected software by Jiyu Yan: Terminal Spike, Pi Edge, OpsDesk AI, and Ralph Loop."
>
  <PageHeader title="Projects" />
  <div class="site-width project-collection">
    <section
      id="terminal-spike"
      class="project-detail"
      aria-labelledby="terminal-title"
    >
      <div class="project-detail-copy" data-reveal>
        <p class="eyebrow">01 / Native Android · Developer tools</p><h2
          id="terminal-title"
        >
          Terminal Spike<span>.</span>
        </h2><p class="project-lede">Your remote workspace, on Android.</p><p>
          My open-source Android terminal for SSH, built-in Mosh, and remote
          coding. Resume Herdr spaces and agents, navigate with touch, and
          follow links into code-server or Obsidian. Connection details stay on
          your device.
        </p><dl class="project-spec">
          <div><dt>Platform</dt><dd>Native Android</dd></div><div>
            <dt>Built for</dt><dd>Herdr, tmux & remote agents</dd>
          </div><div><dt>Privacy</dt><dd>No analytics or accounts</dd></div>
        </dl><div class="project-actions">
          <a
            class="button button-accent"
            href="https://play.google.com/store/apps/details?id=com.yanjiyu.terminalspike"
            >Get it on Google Play ↗</a
          ><a class="text-link" href="/dev/terminal-spike"
            >Herdr & app writeup →</a
          ><a
            class="text-link"
            href="https://github.com/Anderbone/terminal-spike">View source ↗</a
          ><a class="text-link" href="/projects/terminal-spike/privacy"
            >Privacy policy →</a
          >
        </div>
      </div><div class="project-demo-stage" data-reveal>
        <span class="preview-label">A workspace that goes with you.</span
        ><TerminalSpikeDemo />
      </div>
    </section>
    <section
      id="pi-edge"
      class="project-detail"
      aria-labelledby="pi-edge-title"
    >
      <div class="project-detail-copy" data-reveal>
        <p class="eyebrow">02 / Obsidian · Remote agents</p>
        <h2 id="pi-edge-title">Pi Edge<span>.</span></h2>
        <p class="project-lede">Your notes. Your computer. Pi beside them.</p>
        <p>
          An Obsidian plugin I built to chat with Pi on my computer from my
          phone or desktop. Attach notes and images, switch models, and return
          to earlier conversations without leaving the vault.
        </p>
        <dl class="project-spec">
          <div><dt>Client</dt><dd>Obsidian on mobile & desktop</dd></div>
          <div>
            <dt>Connection</dt><dd>Paired bridge over LAN or Tailscale</dd>
          </div>
          <div><dt>Context</dt><dd>Notes, selections & images</dd></div>
        </dl>
        <div class="project-actions">
          <a class="button button-accent" href="/dev/pi-edge"
            >Explore Pi Edge ↗</a
          >
          <a
            class="text-link"
            href="https://community.obsidian.md/plugins/pi-edge"
            >Install plugin ↗</a
          >
          <a
            class="text-link"
            href="https://github.com/Anderbone/pi-obsidian-edge"
            >View source ↗</a
          >
        </div>
      </div>
      <a class="project-product-image" href="/dev/pi-edge" data-reveal>
        <div class="project-window-bar">
          <span>pi edge / obsidian on a Galaxy Fold</span><span
            aria-hidden="true">↗</span
          >
        </div>
        <img
          src="/images/pi-edge-obsidian.webp"
          width="2256"
          height="2408"
          alt="Pi Edge chat beside an Obsidian note, with a clickable note attachment"
          loading="lazy"
        />
      </a>
    </section>
    <section
      id="workflow"
      class="project-detail"
      aria-labelledby="workflow-title"
    >
      <div class="project-detail-copy" data-reveal>
        <p class="eyebrow">Workflow / Connected tools</p>
        <h2 id="workflow-title">One workspace<span>.</span></h2>
        <p class="project-lede">Pick up the work wherever I am.</p>
        <p>
          Terminal Spike opens my Herdr workspace. code-server gives me a
          browser editor. Obsidian holds the project context, with Pi Edge for
          working with Pi beside my notes. Links connect the views; Tailscale
          connects my devices.
        </p>
        <div class="project-actions">
          <a class="button button-accent" href="/dev/workflow-anywhere"
            >See my workflow ↗</a
          >
        </div>
      </div>
      <div data-reveal><WorkflowMap /></div>
    </section>
    <section
      id="opsdesk-ai"
      class="project-detail"
      aria-labelledby="opsdesk-title"
    >
      <div class="project-detail-copy" data-reveal>
        <p class="eyebrow">03 / AI product · Full stack</p><h2
          id="opsdesk-title"
        >
          OpsDesk AI<span>.</span>
        </h2><p class="project-lede">AI-assisted work. Human judgement.</p><p>
          A policy-gated service desk demo that turns customer enquiries into
          reviewed operational work. Capture an enquiry, extract intent and
          risk, route approved templates, and keep complex cases in human hands.
        </p><dl class="project-spec">
          <div>
            <dt>Automation</dt><dd>Approved templates & risk checks</dd>
          </div><div>
            <dt>Visibility</dt><dd>Confidence, tokens & cost</dd>
          </div><div><dt>Workflow</dt><dd>Triage, review & webhooks</dd></div>
        </dl><div class="project-actions">
          <a
            class="button button-accent"
            href="https://opsdesk-ai.netlify.app/"
            target="_blank"
            rel="noopener">Open live app ↗</a
          ><a
            class="text-link"
            href="https://github.com/Anderbone/opsdesk-ai"
            target="_blank"
            rel="noopener">View source ↗</a
          >
        </div>
      </div><a
        class="project-product-image"
        href="https://opsdesk-ai.netlify.app/"
        target="_blank"
        rel="noopener"
        aria-label="Open OpsDesk AI live demo"
        data-reveal
        ><div class="project-window-bar">
          <span>opsdesk / live demo</span><span aria-hidden="true">↗</span>
        </div><img
          src="/images/opsdesk-ai-preview.png"
          width="1265"
          height="1826"
          alt="OpsDesk AI service desk showing enquiries, approval status, and operational controls"
          loading="lazy"
        /></a
      >
    </section>
    <section
      id="ralph-loop"
      class="project-detail"
      aria-labelledby="ralph-title"
    >
      <div class="project-detail-copy" data-reveal>
        <p class="eyebrow">04 / TypeScript · Agent tooling</p><h2
          id="ralph-title"
        >
          Ralph Loop<span>.</span>
        </h2><p class="project-lede">One plan. One focused run. Repeat.</p><p>
          A small TypeScript CLI for draining a folder of reviewed Markdown
          implementation plans through Codex. Plain files, fresh context, and
          auditable runs keep each change focused and reviewable.
        </p><div class="project-actions">
          <a class="button button-accent" href="/dev/ralph-loop-plan-queue"
            >Read the writeup ↗</a
          ><a
            class="text-link"
            href="https://github.com/Anderbone/ralph-loop"
            target="_blank"
            rel="noopener">View source ↗</a
          >
        </div>
      </div><div class="workflow-terminal" data-reveal>
        <div class="project-window-bar">
          <span>ralph-loop / workflow</span><span aria-hidden="true">↗</span>
        </div><div class="workflow-body">
          <p><span>$</span> ralph --plans ~/plans --once</p><ol>
            {
              [
                "Pick the next runnable plan",
                "Start a focused Codex run",
                "Simplify and review the change",
                "Archive the completed plan",
              ].map((step, index) => (
                <li>
                  <span>0{index + 1}</span>
                  {step}
                  <b aria-hidden="true">↳</b>
                </li>
              ))
            }
          </ol><p class="workflow-result">
            Reviewed plans → verified changes<span
              class="terminal-cursor"
              aria-hidden="true">_</span
            >
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
