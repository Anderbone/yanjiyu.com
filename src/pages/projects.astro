---
import Base from "@/layouts/Base.astro";
import {
  FiArrowUpRight,
  FiBookOpen,
  FiCheckCircle,
  FiCpu,
  FiDatabase,
  FiExternalLink,
  FiGithub,
  FiGitBranch,
  FiShield,
} from "react-icons/fi";

const opsdeskAppUrl = "https://opsdesk-ai.netlify.app/";
const opsdeskSourceUrl = "https://github.com/Anderbone/opsdesk-ai";
const ralphSourceUrl = "https://github.com/Anderbone/ralph-loop";
const ralphWriteupUrl = "/dev/ralph-loop-plan-queue";

const highlights = [
  {
    icon: FiShield,
    title: "Policy-gated AI",
    body: "Approved templates can move automatically; risky or low-confidence work stays queued for review.",
  },
  {
    icon: FiDatabase,
    title: "Operational record",
    body: "The desk keeps raw enquiry text, AI summaries, selected templates, confidence, tokens, and cost visible.",
  },
  {
    icon: FiCpu,
    title: "Workflow demo",
    body: "A full path from enquiry capture to triage, template routing, watchtower events, webhooks, and architecture notes.",
  },
];

const proofPoints = [
  "Service-desk workflow modeled around human approval, not blind automation.",
  "Product UI designed for operators: dense, inspectable, and status-oriented.",
  "AI tooling designed around plain files, fresh context, and auditable runs.",
];

const ralphSteps = [
  "Pick next runnable *.plan.md",
  "Start Codex with one focused plan",
  "Run simplify/review after completion",
  "Archive completed plans into done/",
];
---

<Base
  title="Projects"
  description="Selected software projects by Jiyu Yan, including OpsDesk AI."
  image="/images/opsdesk-ai-preview.png"
>
  <section
    class="projects-page bg-body text-text-dark dark:bg-darkmode-body dark:text-darkmode-text-dark"
  >
    <div class="container">
      <div class="project-hero">
        <div class="project-copy">
          <p class="project-kicker">Selected project</p>
          <h1>OpsDesk AI</h1>
          <p class="project-lede">
            A policy-gated service desk demo that turns customer enquiries into
            reviewed operational work.
          </p>
          <p class="project-summary">
            The project shows a practical AI workflow for local businesses:
            capture the enquiry, extract intent and risk, route approved
            templates, and keep complex cases in human hands.
          </p>
          <div class="project-actions" aria-label="OpsDesk AI links">
            <a
              class="btn btn-primary"
              href={opsdeskAppUrl}
              target="_blank"
              rel="noopener"
            >
              Open live app
              <FiArrowUpRight aria-hidden="true" />
            </a>
            <a
              class="btn btn-outline-primary"
              href={opsdeskSourceUrl}
              target="_blank"
              rel="noopener"
            >
              <FiGithub aria-hidden="true" />
              Source
            </a>
          </div>
        </div>

        <div class="project-stage" aria-label="OpsDesk AI live preview">
          <div class="stage-toolbar">
            <div aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <a href={opsdeskAppUrl} target="_blank" rel="noopener">
              Live preview
              <FiExternalLink aria-hidden="true" />
            </a>
          </div>
          <iframe
            src={opsdeskAppUrl}
            title="OpsDesk AI live preview"
            loading="lazy"
            class="hidden lg:block"></iframe>
          <img
            src="/images/opsdesk-ai-preview.png"
            alt="Screenshot of the OpsDesk AI service desk demo"
            width="1265"
            height="1826"
            loading="eager"
            decoding="async"
            class="lg:hidden"
          />
        </div>
      </div>

      <div class="project-notes" aria-label="OpsDesk AI project details">
        {
          highlights.map(({ icon: Icon, title, body }) => (
            <article>
              <Icon aria-hidden="true" />
              <h2>{title}</h2>
              <p>{body}</p>
            </article>
          ))
        }
      </div>

      <section
        class="project-feature project-feature-ralph"
        aria-labelledby="ralph-title"
      >
        <div class="project-feature-copy">
          <p class="project-kicker">Developer tooling</p>
          <h2 id="ralph-title">Ralph Loop</h2>
          <p>
            A small TypeScript CLI for draining a folder of reviewed Markdown
            implementation plans through Codex, one focused run at a time.
          </p>
          <div class="project-actions" aria-label="Ralph Loop links">
            <a class="btn btn-primary" href={ralphWriteupUrl}>
              <FiBookOpen aria-hidden="true" />
              Read the writeup
            </a>
            <a
              class="btn btn-outline-primary"
              href={ralphSourceUrl}
              target="_blank"
              rel="noopener"
            >
              <FiGithub aria-hidden="true" />
              Source
            </a>
          </div>
        </div>

        <div class="ralph-console" aria-label="Ralph Loop workflow">
          <div class="stage-toolbar">
            <div aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <strong>ralph --plans ~/plans --once</strong>
          </div>
          <div class="ralph-console-body">
            <p><span>$</span> ralph --repo ~/work/app --plans ~/plans/queue</p>
            <ol>
              {
                ralphSteps.map((step, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    {step}
                  </li>
                ))
              }
            </ol>
            <div class="ralph-output">
              <FiGitBranch aria-hidden="true" />
              <span
                >reviewed plans -> fresh Codex context -> verified change ->
                next plan</span
              >
            </div>
          </div>
        </div>
      </section>

      <section class="project-proof" aria-labelledby="proof-title">
        <div>
          <p class="project-kicker">What it demonstrates</p>
          <h2 id="proof-title">
            AI product thinking with production-minded workflow design.
          </h2>
        </div>
        <ul>
          {
            proofPoints.map((item) => (
              <li>
                <FiCheckCircle aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>
</Base>

<style>
  .projects-page {
    padding: 4.5rem 0 5.5rem;
  }

  .project-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 5rem;
    align-items: center;
  }

  .project-copy {
    animation: project-rise 520ms ease-out both;
  }

  .project-kicker {
    margin-bottom: 0.9rem;
    color: rgb(20 184 166);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .project-copy h1 {
    margin-bottom: 1rem;
    color: inherit;
    font-size: 7.5rem;
    line-height: 0.9;
  }

  .project-lede {
    margin-bottom: 1.2rem;
    max-width: 34rem;
    font-size: 1.8rem;
    line-height: 1.25;
  }

  .project-summary {
    max-width: 37rem;
    color: rgb(92 98 105);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  :global(.dark) .project-summary {
    color: rgb(186 194 201);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .project-actions :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .project-stage {
    overflow: hidden;
    min-height: 33rem;
    border: 1px solid rgb(30 41 59);
    border-radius: 8px;
    background: rgb(4 8 14);
    box-shadow: 0 1.5rem 5rem rgb(15 23 42 / 0.24);
    animation: project-rise 660ms ease-out 90ms both;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .project-stage:hover {
    transform: translateY(-4px);
    box-shadow: 0 2rem 5.5rem rgb(15 23 42 / 0.3);
  }

  .stage-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.7rem;
    padding: 0 0.9rem;
    border-bottom: 1px solid rgb(30 41 59);
    color: rgb(148 163 184);
    font-size: 0.8rem;
  }

  .stage-toolbar div {
    display: flex;
    gap: 0.45rem;
  }

  .stage-toolbar span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: rgb(71 85 105);
  }

  .stage-toolbar a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgb(94 234 212);
    font-weight: 700;
  }

  .project-stage iframe {
    display: block;
    width: 100%;
    height: min(68vh, 46rem);
    border: 0;
    background: rgb(4 8 14);
  }

  .project-stage img {
    display: none;
    width: 100%;
    max-height: 36rem;
    object-fit: cover;
    object-position: top;
  }

  .project-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 5rem;
    border-top: 1px solid rgb(226 232 240);
    border-bottom: 1px solid rgb(226 232 240);
    background: rgb(226 232 240);
  }

  :global(.dark) .project-notes {
    border-color: rgb(38 48 61);
    background: rgb(38 48 61);
  }

  .project-notes article {
    padding: 2.3rem;
    background: rgb(255 255 255);
  }

  :global(.dark) .project-notes article {
    background: rgb(10 15 23);
  }

  .project-notes svg {
    width: 1.55rem;
    height: 1.55rem;
    margin-bottom: 1.2rem;
    color: rgb(20 184 166);
  }

  .project-notes h2,
  .project-proof h2 {
    color: inherit;
  }

  .project-notes h2 {
    margin-bottom: 0.7rem;
    font-size: 1.15rem;
  }

  .project-notes p {
    margin: 0;
    color: rgb(92 98 105);
    line-height: 1.65;
  }

  :global(.dark) .project-notes p {
    color: rgb(186 194 201);
  }

  .project-feature {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 4rem;
    align-items: center;
    margin-top: 5rem;
    padding: 4.5rem 0;
    border-bottom: 1px solid rgb(226 232 240);
  }

  :global(.dark) .project-feature {
    border-color: rgb(38 48 61);
  }

  .project-feature-copy h2 {
    margin-bottom: 1rem;
    color: inherit;
    font-size: 3.8rem;
    line-height: 0.95;
  }

  .project-feature-copy p {
    max-width: 38rem;
    color: rgb(92 98 105);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  :global(.dark) .project-feature-copy p {
    color: rgb(186 194 201);
  }

  .ralph-console {
    overflow: hidden;
    border: 1px solid rgb(38 48 61);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgb(12 18 28), rgb(4 8 14)), rgb(4 8 14);
    color: rgb(226 232 240);
    box-shadow: 0 1.5rem 4rem rgb(15 23 42 / 0.24);
  }

  .ralph-console .stage-toolbar strong {
    color: rgb(148 163 184);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .ralph-console-body {
    padding: 1.4rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
  }

  .ralph-console-body p {
    margin: 0 0 1.1rem;
    color: rgb(226 232 240);
    font-size: 0.9rem;
  }

  .ralph-console-body p span {
    color: rgb(94 234 212);
  }

  .ralph-console-body ol {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ralph-console-body li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px solid rgb(38 48 61);
    color: rgb(203 213 225);
    font-size: 0.92rem;
  }

  .ralph-console-body li span {
    color: rgb(94 234 212);
    font-weight: 800;
  }

  .ralph-output {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.2rem;
    padding: 1rem;
    border: 1px solid rgb(20 184 166 / 0.45);
    border-radius: 8px;
    background: rgb(20 184 166 / 0.08);
    color: rgb(204 251 241);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .project-proof {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 5rem;
    align-items: start;
    padding-top: 5rem;
  }

  .project-proof h2 {
    max-width: 36rem;
    font-size: 3.6rem;
    line-height: 1.05;
  }

  .project-proof ul {
    display: grid;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-proof li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid rgb(226 232 240);
    color: rgb(68 75 83);
    line-height: 1.65;
  }

  :global(.dark) .project-proof li {
    border-color: rgb(38 48 61);
    color: rgb(207 213 219);
  }

  .project-proof svg {
    margin-top: 0.22rem;
    color: rgb(20 184 166);
  }

  @keyframes project-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1023px) {
    .projects-page {
      padding-top: 3.5rem;
    }

    .project-hero,
    .project-feature,
    .project-proof {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .project-stage {
      min-height: 0;
    }

    .project-stage iframe {
      display: none;
    }

    .project-stage img {
      display: block;
    }

    .project-copy h1 {
      font-size: 4.5rem;
    }

    .project-lede {
      font-size: 1.35rem;
    }

    .project-feature-copy h2,
    .project-proof h2 {
      font-size: 2.7rem;
    }

    .project-notes {
      grid-template-columns: 1fr;
      margin-top: 3.5rem;
    }

    .project-notes article {
      padding: 1.6rem;
    }
  }

  @media (max-width: 640px) {
    .project-copy h1 {
      font-size: 3.25rem;
    }

    .project-feature-copy h2,
    .project-proof h2 {
      font-size: 2.15rem;
    }

    .project-actions :global(a) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
