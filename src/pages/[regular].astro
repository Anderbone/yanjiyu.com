---
import { localeFrom } from "@/lib/i18n";

const locale = localeFrom(Astro.url);

import Base from "@/layouts/Base.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { getTocItems, shouldShowToc } from "@/lib/utils/tableOfContents";
import PageHeader from "@/partials/PageHeader.astro";
import { render } from "astro:content";

// get static paths for all pages
export async function getStaticPaths() {
  const COLLECTION_FOLDER = "pages";

  const pages = await getSinglePage(COLLECTION_FOLDER);

  const paths = pages.map((page) => ({
    params: {
      regular: page.id,
    },
    props: { page },
  }));
  return paths;
}

const page =
  locale === "zh"
    ? await getListPage("pages", Astro.props.page.id, locale)
    : Astro.props.page;
const { title, meta_title, description, image, toc } = page.data;
const { Content, headings } = await render(page);
const tocItems = getTocItems(headings);
const showToc = shouldShowToc(tocItems, page.body ?? "", {
  explicitToc: toc,
});
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class:list={["site-width", "article-layout", { "no-toc": !showToc }]}>
      <article class="content"><Content /></article>
      {
        showToc && (
          <aside>
            <TableOfContents items={tocItems} />
          </aside>
        )
      }
    </div>
  </section>
</Base>
