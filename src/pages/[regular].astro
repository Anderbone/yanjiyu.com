---
import Base from "@/layouts/Base.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTocItems, shouldShowToc } from "@/lib/utils/tableOfContents";
import PageHeader from "@/partials/PageHeader.astro";
import { render } from "astro:content";

// get static paths for all pages
export async function getStaticPaths() {
  const COLLECTION_FOLDER = "pages";

  const pages = await getSinglePage(COLLECTION_FOLDER);

  const paths = pages.map((page) => ({
    params: {
      regular: page.id,
    },
    props: { page },
  }));
  return paths;
}

const { page } = Astro.props;
const { title, meta_title, description, image, toc } = page.data;
const { Content, headings } = await render(page);
const tocItems = getTocItems(headings);
const showToc = shouldShowToc(tocItems, page.body ?? "", {
  explicitToc: toc,
});
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class={showToc ? "lg:col-10 xl:col-8" : "lg:col-10"}>
          <div class="content">
            <Content />
          </div>
        </div>
        {
          showToc && (
            <aside class="hidden xl:col-3 xl:block">
              <TableOfContents items={tocItems} />
            </aside>
          )
        }
      </div>
    </div>
  </section>
</Base>
