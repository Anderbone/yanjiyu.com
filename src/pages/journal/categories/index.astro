---
import Base from "@/layouts/Base.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

const COLLECTION = "journal";

const categories = await getTaxonomy(COLLECTION, "categories");
const allCategories = await getAllTaxonomy(COLLECTION, "categories");
---

<Base title={"Journal Categories"}>
  <PageHeader title={"Journal Categories"} />
  <section class="section">
    <div class="site-width">
      <ul class="taxonomy-grid">
        {
          categories.map((category: string) => {
            const count = allCategories.filter((c) => c === category).length;
            return (
              <li>
                <a href={`/${COLLECTION}/categories/${category}`}>
                  {humanize(category)} <span>{count}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>
