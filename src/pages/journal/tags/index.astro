---
import Base from "@/layouts/Base.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

const COLLECTION = "journal";

const tags = await getTaxonomy(COLLECTION, "tags");
const allTags = await getAllTaxonomy(COLLECTION, "tags");
---

<Base title={"Journal Tags"}>
  <PageHeader title={"Journal Tags"} />
  <section class="section">
    <div class="site-width">
      <ul class="taxonomy-grid">
        {
          tags.map((tag: string) => {
            const count = allTags.filter((c) => c === tag).length;
            return (
              <li>
                <a href={`/${COLLECTION}/tags/${tag}`}>
                  {humanize(tag)} <span>{count}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>
