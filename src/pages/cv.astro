      </section>

      <section class="cv-flow" aria-labelledby="flow-title">
        <div>
          <p class="cv-flow__eyebrow">Full-cycle delivery</p>
          <h2 id="flow-title">
            From discovery to go-live, with engineering reality in the room.
          </h2>
        </div>
        <ol class="cv-flow__steps">
          {
            deliveryFlow.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{step}</strong>
              </li>
            ))
          }
        </ol>
      </section>

      <nav class="cv-jumpbar" aria-label="CV navigation">
        <p>Jump to</p>
        <a href="#top" data-cv-jump-link>Top</a>
        <a href="#selected" data-cv-jump-link>Selected</a>
        <a href="#work" data-cv-jump-link>Work</a>
        <a href="#education" data-cv-jump-link>Education</a>
        <a href="#skills" data-cv-jump-link>Skills</a>
        <a href="#additional" data-cv-jump-link>Additional</a>
      </nav>

      <div class="cv-content">
        <main class="cv-main" aria-label="Main CV content">
          <section
            id="selected"
            class="cv-section"
            aria-labelledby="selected-title"
