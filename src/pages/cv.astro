---
import Base from "@/layouts/Base.astro";
import {
  IoBusinessOutline,
  IoCallOutline,
  IoCodeSlashOutline,
  IoGitBranchOutline,
  IoLogoGithub,
  IoLogoLinkedin,
  IoMailOutline,
  IoPrintOutline,
} from "react-icons/io5";

const profile = {
  name: "Jiyu Yan",
  title: "Solutions Engineer / Full-stack Software Engineer",
  headline: "Customer-facing delivery with hands-on product engineering.",
  location: "Wrexham, UK",
  workStatus: "UK ILR | No visa sponsorship required",
  remote: "Open to remote / hybrid",
  email: "yn.jiyu@gmail.com",
  phone: "+44 747 337 2563",
  github: "github.com/Anderbone",
  githubUrl: "https://github.com/Anderbone",
  linkedin: "linkedin.com/in/jiyu-yan",
  linkedinUrl: "https://www.linkedin.com/in/jiyu-yan/",
  website: "yanjiyu.com",
  websiteUrl: "https://yanjiyu.com",
  summary:
    "Solutions Engineer and Full-stack Software Engineer with 6+ years delivering enterprise software, integrations, automation, reporting, and data-heavy workflows for global clients. I combine requirements discovery, demos, solution architecture, JavaScript/TypeScript, Java/Spring, SQL, REST APIs, PostgreSQL/SQL Server, vertical-slice architecture, and AI-assisted full-stack development to turn ambiguous customer workflows into production-ready systems.",
};

const highlights = [
  {
    value: "6+ years",
    label: "Enterprise implementation, support, and product engineering",
  },
  {
    value: "10+ projects",
    label: "Global customer implementations delivered from discovery to go-live",
  },
  {
    value: "1h → 2m",
    label:
      "Multi-level BOM setup workflow automated and adopted in implementation practice",
  },
  {
    value: "60% faster onboarding",
    label:
      "Best-practice solutions, tutorials, and documentation reduced initial implementation time",
  },
];

const strengths = [
  {
    icon: IoCodeSlashOutline,
    title: "Full-stack implementation",
    text: "Builds JavaScript/TypeScript product logic, Java/Spring changes, SQL procedures, reports, API integrations, and automated setup workflows.",
  },
  {
    icon: IoBusinessOutline,
    title: "Customer-facing delivery",
    text: "Leads discovery, demos, scoping, specifications, stakeholder alignment, training, go-live planning, and post-launch adoption.",
  },
  {
    icon: IoGitBranchOutline,
    title: "Enterprise workflows",
    text: "Turns messy reporting, ERP/SAP, database, configuration, and operational constraints into technical designs that teams can ship and customers can trust.",
  },
];

const deliveryFlow = [
  "Discover",
  "Demo",
  "Scope",
  "Design",
  "Build",
  "Integrate",
  "Go-live",
  "Iterate",
];
const deliveryFlowText = deliveryFlow.join(" · ");

const experience = [
  {
    company: "UL Solutions",
    period: "2019 - Present",
    note: "formerly Cimteq",
    roles: [
      {
        title: "Software Implementation Engineer",
        period: "2021 - Present",
        bullets: [
          "Delivered 10+ complex enterprise implementations for global clients, owning requirements discovery, solution architecture, specification writing, configuration, custom development, testing, and go-live delivery.",
          "Led customer-facing technical discussions from pre-sales demos through implementation and go-live, translating ambiguous business requirements into customisation strategy, integration design, and product-minded feature definition and delivery.",
          "Delivered production Java/Spring and SQL changes across warehouse, machine, stop-code, configuration, reporting, and integration workflows, covering backend logic, validation, issue diagnosis, testing, and release support.",
          "Built and maintained SAP/ERP integrations using Java interface logic, REST API workflows, data validation, SQL/database logic, and customer-specific business rules.",
          "Designed a multi-level BOM automation workflow in JavaScript that reduced setup time from around 1 hour to 2 minutes, was adopted in implementation practice, used in sales demos, and shaped feature direction and product roadmap decisions.",
          "Defined reusable solution patterns in JavaScript, reporting, data setup, and workflow design, improving delivery consistency and expanding what the implementation team could deliver.",
          "Standardized best-practice solutions, tutorials, and documentation to reduce customer implementation time.",
        ],
      },
      {
        title: "Technical Support Analyst",
        period: "2019 - 2021",
        bullets: [
          "Resolved high-complexity production issues across application logic, configuration, databases, reporting, and integrations, handling 96% more tickets than the team average.",
          "Built internal Python tooling to automate report and XML investigation workflows, reducing repetitive investigation effort for consultants and developers.",
          "Authored the team's highest volume of technical Confluence knowledge-base pages, supporting recurring application, reporting, and integration issues.",
          "Improved internationalisation and reporting workflows using Regex, Java reporting tools, and repeatable investigation patterns.",
        ],
      },
    ],
  },
];

const selectedWork = [
  {
    period: "Product workflow",
    title: "Multi-level BOM automation",
    detail:
      "Designed a JavaScript automation workflow that reduced a repeated setup task from around 1 hour to 2 minutes by traversing product layers, reusing existing components, and generating missing structures. The workflow was adopted in implementation practice, used in sales demos, and shaped feature direction and product roadmap decisions.",
    chips: [
      "JavaScript",
      "workflow automation",
      "product configuration",
      "implementation patterns",
      "sales demos",
    ],
  },
  {
    period: "Enterprise integrations",
    title: "SAP / ERP, reporting, and backend delivery",
    detail:
      "Built customer-specific enterprise workflows across Java/Spring backend logic, REST API flows, SQL procedures, data validation, SAP/ERP integrations, and PDF/RTF/Excel reporting.",
    chips: [
      "Java/Spring",
      "SQL Server",
      "REST APIs",
      "SAP/ERP",
      "stored procedures",
      "reporting",
    ],
  },
  {
    period: "Personal product",
    title: "Full-stack AI product development",
    detail:
      "Building a personal full-stack AI product with React, TypeScript, Node.js, PostgreSQL, Prisma, Vercel AI SDK, Better Auth, Zod, Playwright, Vitest, Codex-assisted development workflows, and deployment tooling.",
    chips: [
      "React",
      "TypeScript",
      "PostgreSQL",
      "Prisma",
      "Vercel AI SDK",
      "Codex",
      "Playwright",
      "Vitest",
    ],
  },
  {
    period: "Internal tooling",
    title: "Support automation and knowledge systems",
    detail:
      "Created Python tools, repeatable investigation patterns, and Confluence documentation that improved report/XML investigation and cross-team support consistency.",
    chips: [
      "Python",
      "XML",
      "Confluence",
      "Regex",
      "Java reporting",
      "production issue investigation",
    ],
  },
];

const skills = [
  ["Programming", "JavaScript · TypeScript · SQL · Python · Java"],
  ["Frontend / product", "React · React Router · Vite · Tailwind CSS · shadcn/ui"],
  [
    "Backend / API",
    "Java/Spring · Node.js · REST APIs · PostgreSQL · SQL Server · Prisma · SAP/ERP integrations · AWS",
  ],
  [
    "Testing / tooling",
    "Git · GitHub Actions · Linux · Docker · Playwright · Vitest · pnpm · OpenAPI/Swagger · Zod",
  ],
  [
    "AI-assisted product development",
    "Vercel AI SDK · Codex · Better Auth · AI-assisted workflows · full-stack product development",
  ],
  [
    "Delivery practices",
    "Customer discovery · pre-sales demos · solution architecture · workflow design · stakeholder management · go-live delivery · product-minded feature definition",
  ],
  [
    "Engineering practices",
    "Vertical-slice architecture · system design · schema design · integration design · business-rule implementation · technical documentation",
  ],
];

const education = [
  {
    period: "2018 - 2019",
    title: "MSc Computer Science, University of Warwick",
    detail:
      "Distinction. Modules included high-performance computing, data mining, data analysis, sensor networks, and natural language processing. Built a Python auction bot scoring 7.2/7.5, top among 60+ submissions.",
  },
  {
    period: "2011 - 2018",
    title: "University of Electronic Science and Technology of China",
    detail:
      "MSc Electronics and Communication Engineering; BEng Communication Engineering. GPA 3.7 / 4.0.",
  },
];

const additional = [
  {
    period: "Languages",
    title: "English, Mandarin",
  },
  {
    period: "Personal",
    title: "Full-stack AI product",
    detail:
      "React, TypeScript, PostgreSQL/Prisma, Vercel AI SDK, Better Auth, Zod validation, Playwright, Vitest, Codex-assisted development workflows, and deployment tooling.",
  },
  {
    period: "2022",
    title: "Wikimedia Hackathon contributor",
    detail:
      "Contributed UI and backend improvements to Quarry using Python, Flask, and Docker.",
    href: "https://github.com/toolforge/quarry",
  },
  {
    period: "2018",
    title: "Second place, Warwick National Novices Fencing Tournament",
  },
  {
    period: "2016–2017",
    title: "Teaching assistant, undergraduate TCP/IP course",
  },
];
---

<Base
  title={`${profile.name} CV`}
  description="Professional CV for Jiyu Yan, a UK-based software engineer and implementation specialist."
>
  <section class="cv-page">
    <div class="cv-shell">
      <header class="cv-hero" aria-labelledby="cv-title">
        <div class="cv-identity">
          <h1 id="cv-title">{profile.name}</h1>
          <p class="cv-role">{profile.title}</p>
          <p class="cv-headline">{profile.headline}</p>
          <p class="cv-summary">{profile.summary}</p>
        </div>

        <aside class="cv-topbar" aria-label="CV navigation and contact">
          <div class="cv-meta" aria-label="Location and work status">
            <span>{profile.location}</span>
            <span>{profile.remote}</span>
            <span>{profile.workStatus}</span>
          </div>

          <div class="cv-contact" aria-label="Contact and profile links">
            <a href={`mailto:${profile.email}`}>
              <IoMailOutline aria-hidden="true" />
              <span>{profile.email}</span>
            </a>
            <a href={profile.githubUrl} target="_blank" rel="noopener">
              <IoLogoGithub aria-hidden="true" />
              <span>{profile.github}</span>
            </a>
            <a href={profile.linkedinUrl} target="_blank" rel="noopener">
              <IoLogoLinkedin aria-hidden="true" />
              <span>{profile.linkedin}</span>
            </a>
            <a href={profile.websiteUrl} target="_blank" rel="noopener">
              <IoBusinessOutline aria-hidden="true" />
              <span>{profile.website}</span>
            </a>
            <a href={`tel:${profile.phone.replaceAll(" ", "")}`}>
              <IoCallOutline aria-hidden="true" />
              <span>{profile.phone}</span>
            </a>
            <button type="button" data-print-cv>
              <IoPrintOutline aria-hidden="true" />
              <span>Print CV</span>
            </button>
          </div>
        </aside>
      </header>

      <section class="cv-proof" aria-label="Career proof points">
        {
          highlights.map((highlight) => (
            <div>
              <strong>{highlight.value}</strong>
              <span>{highlight.label}</span>
            </div>
          ))
        }
      </section>

      <section class="cv-strengths" aria-label="Strengths">
        {
          strengths.map((strength) => {
            const Icon = strength.icon;
            return (
              <article class="cv-strength">
                <Icon aria-hidden="true" />
                <h2>{strength.title}</h2>
                <p>{strength.text}</p>
              </article>
            );
          })
        }
      </section>

      <section class="cv-flow" aria-labelledby="flow-title">
        <div>
          <p class="cv-flow__eyebrow">Full-cycle delivery</p>
          <h2 id="flow-title">
            From discovery to go-live, with engineering reality in the room.
          </h2>
        </div>
        <p class="cv-flow__steps">{deliveryFlowText}</p>
      </section>

      <nav class="cv-jumpbar" aria-label="CV navigation">
        <p>Jump to</p>
        <a href="#selected">Selected</a>
        <a href="#work">Work</a>
        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#additional">Additional</a>
      </nav>

      <div class="cv-content">
        <main class="cv-main" aria-label="Main CV content">
          <section
            id="selected"
            class="cv-section"
            aria-labelledby="selected-title"
          >
            <div class="cv-section__head">
              <p>Selected</p>
              <div>
                <h2 id="selected-title">Selected</h2>
                <p class="cv-section__subtitle">
                  Evidence across implementation, engineering, and product
                </p>
              </div>
            </div>
            <div class="cv-stack cv-stack--selected">
              {
                selectedWork.map((item) => (
                  <article class="cv-mini">
                    <span>{item.period}</span>
                    <h3>{item.title}</h3>
                    <p>{item.detail}</p>
                    <div class="cv-chips" aria-label={`${item.title} methods`}>
                      {item.chips.map((chip) => (
                        <span>{chip}</span>
                      ))}
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section
            id="work"
            class="cv-section"
            aria-labelledby="experience-title"
          >
            <div class="cv-section__head">
              <p>Experience</p>
              <h2 id="experience-title">
                Enterprise delivery with hands-on engineering
              </h2>
            </div>
            {
              experience.map((item) => (
                <article class="cv-company">
                  <div class="cv-company__head">
                    <div>
                      <h3>{item.company}</h3>
                      <p>{item.note}</p>
                    </div>
                    <span>{item.period}</span>
                  </div>
                  <div class="cv-roles">
                    {item.roles.map((role) => (
                      <section class="cv-role-block">
                        <div class="cv-role-block__head">
                          <h4>{role.title}</h4>
                          <span>{role.period}</span>
                        </div>
                        <ul>
                          {role.bullets.map((bullet) => (
                            <li>{bullet}</li>
                          ))}
                        </ul>
                      </section>
                    ))}
                  </div>
                </article>
              ))
            }
          </section>

          <section
            id="education"
            class="cv-section"
            aria-labelledby="education-title"
          >
            <div class="cv-section__head">
              <p>Education</p>
              <h2 id="education-title">Academic background</h2>
            </div>
            <div class="cv-stack cv-stack--education">
              {
                education.map((item) => (
                  <article class="cv-mini">
                    <span>{item.period}</span>
                    <h3>{item.title}</h3>
                    <p>{item.detail}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section
            id="skills"
            class="cv-section"
            aria-labelledby="skills-title"
          >
            <div class="cv-section__head">
              <p>Skills</p>
              <h2 id="skills-title">Technical range</h2>
            </div>
            <div class="cv-skill-list">
              {
                skills.map(([group, items]) => (
                  <div class="cv-skill">
                    <h3>{group}</h3>
                    <p>{items}</p>
                  </div>
                ))
              }
            </div>
          </section>

          <section
            id="additional"
            class="cv-section"
            aria-labelledby="additional-title"
          >
            <div class="cv-section__head">
              <p>Additional</p>
              <h2 id="additional-title">Additional</h2>
            </div>
            <div class="cv-stack">
              {
                additional.map((item) => (
                  <article class="cv-mini">
                    <span>{item.period}</span>
                    <h3>
                      {item.href ? (
                        <a href={item.href} target="_blank" rel="noopener">
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>
                    {item.detail && <p>{item.detail}</p>}
                  </article>
                ))
              }
            </div>
          </section>
        </main>
      </div>
    </div>
  </section>

  <script>
    document.querySelector("[data-print-cv]")?.addEventListener("click", () => {
      window.print();
    });
  </script>
</Base>

<style>
  .cv-page {
    --cv-ink: #111827;
    --cv-muted: #586271;
    --cv-soft: #f7f8f8;
    --cv-paper: #ffffff;
    --cv-line: #dfe5e8;
    --cv-accent: #0f766e;
    --cv-warm: #b45309;
    background: var(--cv-paper);
    color: var(--cv-ink);
  }

  :global(.dark) .cv-page {
    --cv-ink: #f8fafc;
    --cv-muted: #bac4d1;
    --cv-soft: #181c20;
    --cv-paper: #111316;
    --cv-line: #334155;
    --cv-accent: #5eead4;
    --cv-warm: #fbbf24;
  }

  .cv-shell {
    width: min(980px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2.25rem, 5vw, 4.5rem) 0 clamp(5.5rem, 8vw, 7rem);
  }

  .cv-hero {
    display: grid;
    gap: clamp(1.6rem, 4vw, 2.4rem);
    padding: 0 0 clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--cv-line);
  }

  .cv-identity,
  .cv-topbar {
    animation: cv-rise 560ms ease both;
  }

  .cv-topbar {
    animation-delay: 80ms;
  }

  .cv-identity h1 {
    margin: 0;
    color: var(--cv-ink);
    font-size: clamp(3rem, 7vw, 5.6rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .cv-role {
    max-width: 46rem;
    margin: 1rem 0 0;
    color: var(--cv-ink);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1.12;
  }

  .cv-headline {
    max-width: 44rem;
    margin: 1rem 0 0;
    color: var(--cv-accent);
    font-size: clamp(1.15rem, 2.1vw, 1.7rem);
    font-weight: 700;
    line-height: 1.18;
  }

  .cv-summary {
    max-width: 55rem;
    margin: 1.15rem 0 0;
    color: var(--cv-muted);
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.7;
  }

  .cv-topbar {
    display: grid;
    gap: 1.1rem;
    border-top: 1px solid var(--cv-line);
    padding-top: 1.25rem;
  }

  .cv-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.25rem;
    padding: 0 0 1rem;
    border-bottom: 1px solid var(--cv-line);
  }

  .cv-meta span {
    display: block;
    color: var(--cv-ink);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .cv-meta span:first-child {
    color: var(--cv-accent);
  }

  .cv-contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.55rem;
  }

  .cv-contact a,
  .cv-contact button,
  .cv-jumpbar a {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.55rem;
    color: var(--cv-ink);
    font: inherit;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .cv-contact a,
  .cv-contact button {
    width: 100%;
    min-height: 2.6rem;
    border: 1px solid var(--cv-line);
    border-radius: 0.45rem;
    background: var(--cv-paper);
    padding: 0.68rem 0.8rem;
    cursor: pointer;
  }

  .cv-contact span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cv-contact svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--cv-accent);
  }

  .cv-contact a:hover,
  .cv-contact button:hover,
  .cv-jumpbar a:hover {
    border-color: var(--cv-accent);
    background: var(--cv-soft);
    color: var(--cv-accent);
    transform: translateY(-1px);
  }

  .cv-proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border-bottom: 1px solid var(--cv-line);
    background: var(--cv-line);
  }

  .cv-proof div {
    display: grid;
    gap: 0.35rem;
    background: var(--cv-paper);
    padding: clamp(1.1rem, 2.5vw, 1.75rem) 0;
  }

  .cv-proof strong {
    color: var(--cv-ink);
    font-size: clamp(1.45rem, 2.8vw, 2.3rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .cv-proof span {
    max-width: 13rem;
    color: var(--cv-muted);
    line-height: 1.35;
  }

  .cv-strengths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border-bottom: 1px solid var(--cv-line);
    background: var(--cv-line);
  }

  .cv-strength {
    background: var(--cv-soft);
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
  }

  .cv-strength svg {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--cv-accent);
  }

  .cv-strength h2 {
    margin: 1.4rem 0 0.5rem;
    color: var(--cv-ink);
    font-size: clamp(1.08rem, 1.7vw, 1.35rem);
    line-height: 1.12;
  }

  .cv-strength p {
    margin: 0;
    color: var(--cv-muted);
    line-height: 1.58;
  }

  .cv-flow {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--cv-line);
  }

  .cv-flow__eyebrow {
    margin: 0 0 0.6rem;
    color: var(--cv-accent);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cv-flow h2 {
    max-width: 30rem;
    margin: 0;
    color: var(--cv-ink);
    font-size: clamp(1.45rem, 2.6vw, 2.25rem);
    line-height: 1.08;
  }

  .cv-flow__steps {
    margin: 0;
    border: 1px solid var(--cv-line);
    background: var(--cv-paper);
    padding: clamp(1rem, 2.5vw, 1.4rem);
    color: var(--cv-ink);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 800;
    line-height: 1.55;
  }

  .cv-content {
    max-width: 860px;
    margin: 0 auto;
  }

  .cv-jumpbar {
    position: fixed;
    z-index: 40;
    bottom: 0.85rem;
    left: 50%;
    display: flex;
    width: min(calc(100% - 1rem), 40rem);
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1px solid color-mix(in srgb, var(--cv-line), transparent 15%);
    border-radius: 999px;
    background: color-mix(in srgb, var(--cv-paper), transparent 5%);
    padding: 0.45rem;
    box-shadow: 0 1rem 2.5rem rgb(15 23 42 / 12%);
    transform: translateX(-50%);
    backdrop-filter: blur(18px);
  }

  .cv-jumpbar p {
    margin: 0 0.35rem 0 0.2rem;
    color: var(--cv-muted);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .cv-jumpbar a {
    justify-content: center;
    min-height: 2.15rem;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    font-size: 0.86rem;
  }

  .cv-section {
    scroll-margin-top: 6.25rem;
    padding: clamp(2.3rem, 5vw, 3.8rem) 0;
    border-bottom: 1px solid var(--cv-line);
  }

  .cv-section__head {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 1rem;
    margin-bottom: clamp(1.35rem, 3vw, 2.2rem);
  }

  .cv-section__head p {
    margin: 0.18rem 0 0;
