            </div>
          </section>

          <section
            id="work"
            class="cv-section"
            aria-labelledby="experience-title"
          >
            <div class="cv-section__head">
              <h2 id="experience-title">
                Experience
              </h2>
            </div>
            {
              experience.map((item) => (
                <article class="cv-company">
                  <div class="cv-company__head">
                    <div>
                      <h3>{item.company}</h3>
                      <p>{item.note}</p>
                    </div>
                    <span>{item.period}</span>
                  </div>
                  <div class="cv-roles">
                    {item.roles.map((role) => (
                      <section class="cv-role-block">
                        <div class="cv-role-block__head">
                          <h4>{role.title}</h4>
                          <span>{role.period}</span>
                        </div>
                        <ul>
                          {role.bullets.map((bullet) => (
                            <li>{bullet}</li>
                          ))}
                        </ul>
                      </section>
                    ))}
                  </div>
                </article>
              ))
            }
          </section>

          <section
            id="education"
            class="cv-section"
            aria-labelledby="education-title"
          >
            <div class="cv-section__head">
              <h2 id="education-title">Education</h2>
            </div>
            <div class="cv-stack cv-stack--education">
              {
                education.map((item) => (
                  <article class="cv-mini">
                    <span>{item.period}</span>
                    <h3>{item.title}</h3>
                    <p>{item.detail}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section
            id="skills"
            class="cv-section"
            aria-labelledby="skills-title"
          >
            <div class="cv-section__head">
              <h2 id="skills-title">Skills</h2>
            </div>
            <div class="cv-skill-list">
              {
                skills.map(([group, items]) => (
                  <div class="cv-skill">
                    <h3>{group}</h3>
                    <p>{items}</p>
                  </div>
                ))
              }
            </div>
          </section>

          <section
            id="additional"
            class="cv-section"
            aria-labelledby="additional-title"
          >
            <div class="cv-section__head">
              <h2 id="additional-title">Additional</h2>
            </div>
            <div class="cv-stack">
              {
                additional.map((item) => (
                  <article class="cv-mini">
                    <span>{item.period}</span>
                    <h3>
                      {item.href ? (
                        <a href={item.href} target="_blank" rel="noopener">
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>
                    {item.detail && <p>{item.detail}</p>}
                  </article>
                ))
              }
            </div>
          </section>
        </main>
      </div>
    </div>
  </section>

</Base>

<script is:inline data-astro-rerun>
  (() => {
    const previousObserver = window.__cvJumpbarObserver;
    if (previousObserver) {
      previousObserver.disconnect();
    }

    const jumpLinks = Array.from(
      document.querySelectorAll("[data-cv-jump-link]"),
    );
    const jumpTargets = jumpLinks
      .map((link) => {
        const id = link.hash.slice(1);
        const target = document.getElementById(id);
        return target ? { id, target } : null;
      })
      .filter(Boolean);

    const setActiveJumpLink = (id) => {
      jumpLinks.forEach((link) => {
        const isActive = link.hash === `#${id}`;
        link.classList.toggle("is-active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    if (jumpTargets.length === 0) {
      return;
    }

    setActiveJumpLink("top");
    jumpLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setActiveJumpLink(link.hash.slice(1));
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) =>
              Math.abs(a.boundingClientRect.top) -
              Math.abs(b.boundingClientRect.top),
          )[0];

        if (visible?.target.id) {
          setActiveJumpLink(visible.target.id);
        }
      },
      {
        rootMargin: "-20% 0px -65% 0px",
        threshold: 0,
      },
    );

    jumpTargets.forEach(({ target }) => observer.observe(target));
    window.__cvJumpbarObserver = observer;
  })();
</script>

<style>
  .cv-page {
    --cv-ink: #111827;
    --cv-muted: #586271;
    --cv-soft: #f7f8f8;
    --cv-paper: #ffffff;
    --cv-line: #dfe5e8;
    --cv-accent: #0f766e;
    --cv-warm: #b45309;
    background: var(--cv-paper);
    color: var(--cv-ink);
  }

  :global(.dark) .cv-page {
    --cv-ink: #f8fafc;
    --cv-muted: #bac4d1;
    --cv-soft: #181c20;
    --cv-paper: #111316;
    --cv-line: #334155;
    --cv-accent: #5eead4;
    --cv-warm: #fbbf24;
  }

  .cv-shell {
    width: min(980px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2.25rem, 5vw, 4.5rem) 0 clamp(5.5rem, 8vw, 7rem);
  }

  .cv-hero {
    display: grid;
    gap: clamp(1.6rem, 4vw, 2.4rem);
    padding: 0 0 clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--cv-line);
  }

  .cv-identity,
  .cv-topbar {
    animation: cv-rise 560ms ease both;
  }

  .cv-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1rem;
  }

  .cv-topbar {
    animation-delay: 80ms;
  }

  .cv-identity h1 {
    margin: 0;
    color: var(--cv-ink);
    font-size: clamp(1.9rem, 3.3vw, 2.65rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .cv-role {
    max-width: 46rem;
    margin: 0;
    color: var(--cv-ink);
    font-size: clamp(0.95rem, 1.25vw, 1.12rem);
    font-weight: 700;
    line-height: 1.18;
  }

  .cv-headline {
    max-width: 58rem;
    margin: 0.85rem 0 0;
    color: var(--cv-accent);
    font-size: clamp(1.05rem, 1.65vw, 1.35rem);
    font-weight: 700;
    line-height: 1.18;
  }

  .cv-summary {
    max-width: 55rem;
    margin: 1.15rem 0 0;
    color: var(--cv-muted);
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.7;
  }

  .cv-topbar {
    display: grid;
    gap: 1.1rem;
    border-top: 1px solid var(--cv-line);
    padding-top: 1.25rem;
  }

  .cv-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.18rem 0;
    align-items: center;
    margin: 0;
    padding: 0 0 1rem;
    border-bottom: 1px solid var(--cv-line);
    color: var(--cv-ink);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.65;
  }

  .cv-meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
  }

  .cv-meta__place {
    color: var(--cv-accent);
  }

  .cv-meta svg {
    width: 0.95rem;
    height: 0.95rem;
    flex: 0 0 auto;
  }

  .cv-meta__separator {
    margin: 0 0.45rem;
    color: var(--cv-muted);
  }

  .cv-meta__separator--wide {
    margin-right: 0.85rem;
    margin-left: 0.85rem;
  }

  .cv-contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.55rem;
  }

  .cv-contact a,
  .cv-contact button,
  .cv-jumpbar a {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.55rem;
    color: var(--cv-ink);
    font: inherit;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .cv-contact a,
  .cv-contact button {
    width: 100%;
    min-height: 2.6rem;
    border: 1px solid var(--cv-line);
    border-radius: 0.45rem;
    background: var(--cv-paper);
    padding: 0.68rem 0.8rem;
    cursor: pointer;
  }

  .cv-contact span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cv-contact svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--cv-accent);
  }

  .cv-contact a:hover,
  .cv-contact button:hover,
  .cv-jumpbar a:hover,
  .cv-jumpbar a.is-active {
    border-color: var(--cv-accent);
    background: var(--cv-soft);
    color: var(--cv-accent);
    transform: translateY(-1px);
  }

  .cv-jumpbar a.is-active {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--cv-accent), transparent 60%);
  }

  .cv-proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border-bottom: 1px solid var(--cv-line);
    background: var(--cv-line);
  }

  .cv-proof div {
    display: grid;
    gap: 0.35rem;
    background: var(--cv-paper);
    padding: clamp(1.15rem, 2.5vw, 1.75rem) clamp(1rem, 2vw, 1.35rem);
  }

  .cv-proof strong {
    color: var(--cv-ink);
    font-size: clamp(1.45rem, 2.8vw, 2.3rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

