---
import { translator, localeFrom } from "@/lib/i18n";

const locale = localeFrom(Astro.url);
const t = translator(Astro.url);

import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getListPage } from "@/lib/contentParser.astro";
const contact = await getListPage("contact", "-index", locale);
if (contact.data.draft) return Astro.redirect("/404");
const links = [
  {
    label: "Email",
    value: "hi@yanjiyu.com",
    href: "mailto:hi@yanjiyu.com",
  },
  { label: "GitHub", value: "Anderbone", href: "https://github.com/Anderbone" },
  {
    label: "LinkedIn",
    value: "Jiyu Yan",
    href: "https://www.linkedin.com/in/jiyu-yan/",
  },
];
---

<Base title={t("Contact Jiyu Yan")} description={contact.data.description}
  ><PageHeader title={t("Contact")} /><section class="site-width section-space">
    <p style="max-width:620px;margin-bottom:40px;line-height:1.9">
      {
        t(
          "I’m open to software engineering, implementation, integration, and product workflow roles in the UK. Email is the most reliable way to reach me.",
        )
      }
    </p><div class="contact-list">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener" : undefined}
          >
            <>
              <span>{t(link.label)}</span>
              <strong>{link.value}</strong>
              <b aria-hidden="true">↗</b>
            </>
          </a>
        ))
      }
    </div>
  </section></Base
>
