---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { render } from "astro:content";
const about = await getListPage("about", "-index");
const { Content } = await render(about);
if (about.data.draft) return Astro.redirect("/404");
---

<Base title="About Jiyu Yan" description={about.data.description}>
  <div class="site-width about-page">
    <aside class="about-details" aria-label="At a glance">
      <p class="eyebrow">At a glance</p>
      <dl>
        <div><dt>Based in</dt><dd>Wrexham, UK</dd></div><div>
          <dt>Working on</dt><dd>Product systems, integrations & AI tools</dd>
        </div><div>
          <dt>Experience</dt><dd>6+ years in enterprise software</dd>
        </div><div>
          <dt>Away from the keyboard</dt><dd>Fencing, books & writing</dd>
        </div>
      </dl>
      <a class="text-link" href="/cv"
        >Experience & CV <span aria-hidden="true">↗</span></a
      >
    </aside>
    <article class="about-story">
      <header><p class="eyebrow">About</p><h1>A little about me.</h1></header>
      <div class="content"><Content /></div>
      <a class="text-link about-contact" href="mailto:hi@yanjiyu.com"
        >Say hello <span aria-hidden="true">↗</span></a
      >
    </article>
  </div>
</Base>
