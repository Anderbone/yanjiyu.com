---
import { localeFrom, translator } from "@/lib/i18n";

const locale = localeFrom(Astro.url);
const t = translator(Astro.url);

import BlogCard from "@/components/BlogCard.astro";
import { humanize } from "@/lib/utils/textConverter";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import PageHeader from "@/partials/PageHeader.astro";

const COLLECTION = "dev";

export async function getStaticPaths() {
  const categories = await getTaxonomy("dev", "categories");

  return categories.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const posts = await getSinglePage(COLLECTION, locale);
const filterByCategories = taxonomyFilter(posts, "categories", category!);
const sortedPosts = sortByDate(filterByCategories);
---

<Base title={t(humanize(category!))}>
  <PageHeader title={category} />
  <section class="section">
    <div class="site-width writing-list">
      {
        sortedPosts.map((post) => (
          <BlogCard data={post} collection={COLLECTION} />
        ))
      }
    </div>
  </section>
</Base>
