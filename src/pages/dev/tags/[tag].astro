---
import { localeFrom, translator } from "@/lib/i18n";

const locale = localeFrom(Astro.url);
const t = translator(Astro.url);

import BlogCard from "@/components/BlogCard.astro";
import { humanize } from "@/lib/utils/textConverter";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import PageHeader from "@/partials/PageHeader.astro";

const COLLECTION = "dev";

export async function getStaticPaths() {
  const tags = await getTaxonomy("dev", "tags");

  return tags.map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const posts = await getSinglePage(COLLECTION, locale);
const filterByTags = taxonomyFilter(posts, "tags", tag!);
const sortedPosts = sortByDate(filterByTags);
---

<Base title={t(humanize(tag!))}>
  <PageHeader title={tag} />
  <section class="section">
    <div class="site-width writing-list">
      {
        sortedPosts.map((post) => (
          <BlogCard data={post} collection={COLLECTION} />
        ))
      }
    </div>
  </section>
</Base>
