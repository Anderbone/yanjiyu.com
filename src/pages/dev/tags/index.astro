---
import { translator, localeFrom, localePath } from "@/lib/i18n";

const locale = localeFrom(Astro.url);
const t = translator(Astro.url);

import Base from "@/layouts/Base.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

const COLLECTION = "dev";

const tags = await getTaxonomy(COLLECTION, "tags");
const allTags = await getAllTaxonomy(COLLECTION, "tags");
---

<Base title={"Dev Tags"}>
  <PageHeader title={"Dev Tags"} />
  <section class="section">
    <div class="site-width">
      <ul class="taxonomy-grid">
        {
          tags.map((tag: string) => {
            const count = allTags.filter((c) => c === tag).length;
            return (
              <li>
                <a href={localePath(`/${COLLECTION}/tags/${tag}`, locale)}>
                  {t(humanize(tag))} <span>{count}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>
